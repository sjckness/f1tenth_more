<?xml version="1.0" encoding="UTF-8"?>
<!-- FastDDS profile: UDPv4 only (no shared memory). Needed because the Isaac
     container and the test / Orin side run in different IPC namespaces or hosts.
     For the Orin link, add the Ethernet interface to <interfaceWhiteList>. -->
<profiles xmlns="http://www.eprosima.com/XMLSchemas/fastRTPS_Profiles">
  <transport_descriptors>
    <transport_descriptor>
      <transport_id>udp_only</transport_id>
      <type>UDPv4</type>
      <maxMessageSize>65500</maxMessageSize>
      <sendBufferSize>8388608</sendBufferSize>
      <receiveBufferSize>8388608</receiveBufferSize>
    </transport_descriptor>
  </transport_descriptors>
  <participant profile_name="udp_only_participant" is_default_profile="true">
    <rtps>
      <userTransports>
        <transport_id>udp_only</transport_id>
      </userTransports>
      <useBuiltinTransports>false</useBuiltinTransports>
    </rtps>
  </participant>
</profiles>
