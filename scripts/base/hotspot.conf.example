# The base's hotspot, read by scripts/base/hotspot.sh (bash syntax).
#
#   cp scripts/base/hotspot.conf.example scripts/base/hotspot.conf   # git-ignored
#   edit HOTSPOT_PSK (and HOTSPOT_IFNAME for this PC)
#
# Use the SAME SSID, password and address on linus and on the tpad: the
# car's one NetworkManager profile (scripts/orin/comms_network.sh) then joins
# whichever base is up, and link_manager's local_host stays the same.

HOTSPOT_CON=f1tenth-base          # NetworkManager profile name on this PC
HOTSPOT_SSID=f1tenth-base
HOTSPOT_PSK='change-me-8-to-63-chars'

# The Wi-Fi interface whose radio becomes the access point.
# linus: wlp4s0 (RTL8822CE, rtw88). tpad: see scripts/base/check_ap.sh.
HOTSPOT_IFNAME=wlp4s0

# Address and /24 of the hotspot; the car reaches the base here when Tailscale
# does not answer (link_manager local_host). NOT 10.42.0.1: linus's
# thor-link ethernet already is 10.42.0.1/24.
HOTSPOT_ADDRESS=10.42.50.1/24

# Dedicated mode (HOTSPOT_VIRTUAL=0): the whole radio becomes the AP. Any
# Wi-Fi connection on it (eduroam) goes down, so the internet shared with
# the car must come from another interface (ethernet, USB tethering).
# bg = 2.4 GHz (longer range, walls): channel 1, 6 or 11.
# a  = 5 GHz: 36, 40, 44 or 48 only (52-144 need radar detection, which
# rtw88 cannot do as an AP).
HOTSPOT_BAND=bg
HOTSPOT_CHANNEL=6

# Concurrent mode (HOTSPOT_VIRTUAL=1): keep the Wi-Fi uplink (eduroam) on
# HOTSPOT_IFNAME and add a virtual AP interface on the same radio, sharing
# eduroam's internet. Needs `iw` and sudo, and the radio must allow it
# (`iw list`: "#{ managed } <= 1, #{ AP } <= 1, total <= 2, #channels <= 1"
# on linus). The AP then has to sit on eduroam's channel (taken from the
# link, HOTSPOT_BAND/CHANNEL ignored), which must not be a radar (DFS)
# channel, and it breaks when eduroam roams to another channel.
HOTSPOT_VIRTUAL=0
HOTSPOT_VIF=f1tap0
