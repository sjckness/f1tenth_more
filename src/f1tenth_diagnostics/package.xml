<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>f1tenth_diagnostics</name>
  <version>0.0.1</version>
  <description>
    Calibration and diagnostic tooling for the F1TENTH stack: one-off measurement/
    validation nodes (e.g. gyro bias calibration) that shouldn't live inside the
    production control/perception/hardware packages. Each node here is self-contained,
    single-purpose, and safe to run standalone -- no modifying live params, no
    publishing to control topics, unless a node is explicitly a diagnostic tool for
    that (e.g. an odom noise-floor logger).
  </description>
  <maintainer email="andreas21steffens@gmail.com">andreas</maintainer>
  <license>MIT</license>

  <buildtool_depend>ament_python</buildtool_depend>

  <exec_depend>rclpy</exec_depend>
  <exec_depend>sensor_msgs</exec_depend>
  <exec_depend>nav_msgs</exec_depend>
  <exec_depend>std_msgs</exec_depend>
  <!-- geometry_msgs: PoseWithCovarianceStamped, consumed by
       slam_pose_covariance_calibration_node.py (dual-EKF pass, /slam/pose
       covariance calibration). -->
  <exec_depend>geometry_msgs</exec_depend>
  <exec_depend>vesc_msgs</exec_depend>
  <!-- diagnostic_msgs + rosidl_runtime_py: ekf_cost_observer_node publishes its
       per update cost metric as a DiagnosticArray on /diagnostics (already in
       mission_logger_node's recorded topic list, so the metric lands in every
       run's bag with no recorder change), and resolves each EKF input topic's
       message type from the graph at runtime via get_message rather than
       hardcoding one type per topic. -->
  <exec_depend>diagnostic_msgs</exec_depend>
  <exec_depend>rosidl_runtime_py</exec_depend>
  <exec_depend>f1tenth_messages</exec_depend>
  <exec_depend>ament_index_python</exec_depend>
  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>
  <exec_depend>python3-psutil</exec_depend>
  <!-- param_defaults.py: shared launch-param defaults (see f1tenth_params/config/
       stack_params.yaml). f1tenth_params is a dependency-free leaf package;
       depending on it here (not f1tenth_bringup) avoids a build-order cycle,
       since f1tenth_bringup itself includes this package's launch file. -->
  <exec_depend>f1tenth_params</exec_depend>
  <!-- ruamel.yaml IS a real rosdep key (verified: `rosdep resolve python3-ruamel.yaml`
       resolves to the apt package of the same name), previously undeclared here on
       the mistaken assumption it had none; now tracked properly instead of a
       manual-install-and-hope comment. Used by calibration_common.write_vesc_yaml
       (shared by both sensor_covariance_calibration_node and, as of the
       automatic-startup-calibration pass, gyro_bias_calibration_node too). -->
  <exec_depend>python3-ruamel.yaml</exec_depend>
  <!-- jetson-stats (jtop) has no rosdep key either: install via
       `sudo pip3 install jetson-stats`, then reboot (or restart jtop.service), before
       running system_observer_node. Node degrades gracefully (see its own module
       docstring) if this is missing, so it's not a hard build/runtime dependency. -->

  <test_depend>ament_copyright</test_depend>
  <test_depend>ament_flake8</test_depend>
  <test_depend>ament_pep257</test_depend>
  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
