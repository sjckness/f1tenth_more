{
  "mission_id": "straight_2m_left_at_wall_then_person",
  "schema_version": "5.0",
  "description": "Straight 2 m; straight until the wall (front_clearance 3.0 m, the default before a turn); wall_turn left 90; straight until a person is seen; go_to_object person at gap 1.1 m. The mission run on the car on 2026-11-23 morning (7 COMPLETE of 10), until then only in the Orin's llm_generated/ (made with plan_translate.translate()); copied here unchanged apart from this description. Needs semantic_layer_node (/costmap/semantic_tracks) and the global EKF.",
  "moves": [
    {
      "id": "move_0_straight",
      "drive": {
        "mode": "straight",
        "speed": 0.5
      },
      "stop_condition": {
        "type": "distance_reached",
        "distance": 2.0
      },
      "timeout_sec": 17,
      "on_timeout": "abort"
    },
    {
      "id": "move_1_straight",
      "drive": {
        "mode": "straight",
        "speed": 0.5
      },
      "stop_condition": {
        "type": "front_clearance",
        "distance": 3.0,
        "debounce_ticks": 3
      },
      "timeout_sec": 65,
      "on_timeout": "abort"
    },
    {
      "id": "move_2_turn",
      "drive": {
        "mode": "wall_turn",
        "turn_sign": 1.0,
        "turn_mag_deg": 90.0,
        "speed": 0.5
      },
      "stop_condition": {
        "type": "orientation_delta",
        "value": 90.0
      },
      "timeout_sec": 27,
      "on_timeout": "abort"
    },
    {
      "id": "move_3_search",
      "drive": {
        "mode": "straight",
        "speed": 0.5
      },
      "stop_condition": {
        "type": "object_seen",
        "class": "person",
        "min_confidence": 0.5
      },
      "timeout_sec": 65,
      "on_timeout": "abort"
    },
    {
      "id": "move_4_go_to",
      "go_to_object": {
        "target_class": "person",
        "gap_m": 1.1,
        "speed": 0.5,
        "acquire_timeout_sec": 5.0,
        "lost_grace_sec": 1.5
      },
      "stop_condition": {
        "type": "object_reached"
      },
      "timeout_sec": 65,
      "on_timeout": "abort",
      "terminal": true
    }
  ]
}
