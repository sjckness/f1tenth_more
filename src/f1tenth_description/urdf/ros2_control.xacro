<?xml version="1.0" ?>
<!--
  ros2_control.xacro - ros2_control hardware + Gazebo Harmonic system plugins.

  ROS 2 Jazzy + Gazebo Harmonic (gz_ros2_control). The Humble/Fortress names
  were ign_ros2_control/IgnitionSystem and ign_ros2_control-system /
  ign_ros2_control::IgnitionROS2ControlPlugin.

  TF-silent sim: the controller_manager gz_ros2_control starts waits for the
  URDF on its relative 'robot_description' topic (gz_ros2_control 1.2.20,
  gz_ros2_control_plugin.cpp: "Wait for CM to receive robot description from
  the topic"). The <ros><remapping> below points it at /sim/robot_description,
  published by f1tenth_sim's private robot_state_publisher, so it can never
  pick up the stack's /robot_description from the Thor.

  Command interfaces (match the AckermannSteeringController):
    rear wheels    -> velocity command  (traction)
    steering hinges-> position command  (steering)
    front wheels   -> passive (state only)

  The friction/contact tuning is kept as legacy <gazebo reference> tags
  (mu1/mu2/kp/kd/fdir1), which libsdformat's URDF parser translates to SDF.
-->
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="roboracer">

  <ros2_control name="roboracer_control" type="system">
    <hardware>
      <plugin>gz_ros2_control/GazeboSimSystem</plugin>
    </hardware>

    <!-- Rear axle: velocity command (traction) -->
    <joint name="left_rear_wheel_joint">
      <command_interface name="velocity"/>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
      <state_interface name="effort"/>
    </joint>
    <joint name="right_rear_wheel_joint">
      <command_interface name="velocity"/>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
      <state_interface name="effort"/>
    </joint>

    <!-- Front wheels: passive -->
    <joint name="left_front_wheel_joint">
      <state_interface name="position"/>
      <state_interface name="velocity"/>
      <state_interface name="effort"/>
    </joint>
    <joint name="right_front_wheel_joint">
      <state_interface name="position"/>
      <state_interface name="velocity"/>
      <state_interface name="effort"/>
    </joint>

    <!-- Steering hinges: position command -->
    <joint name="left_steering_hinge_joint">
      <command_interface name="position"/>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
      <state_interface name="effort"/>
    </joint>
    <joint name="right_steering_hinge_joint">
      <command_interface name="position"/>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
      <state_interface name="effort"/>
    </joint>
  </ros2_control>

  <xacro:if value="$(arg use_sim)">
    <gazebo>
      <plugin filename="gz_ros2_control-system"
              name="gz_ros2_control::GazeboSimROS2ControlPlugin">
        <parameters>$(arg control_config)</parameters>
        <ros>
          <remapping>robot_description:=/sim/robot_description</remapping>
          <!-- Jazzy's controller_manager publishes its own /diagnostics, which
               no car driver does; keep it out of the stack's diagnostics. -->
          <remapping>diagnostics:=/sim/diagnostics</remapping>
        </ros>
      </plugin>

      <!-- Ground truth for evaluation only: nav_msgs/Odometry on
           /sim/ground_truth (bridged by f1tenth_sim). The frame names are
           sim_* on purpose so it can never be mistaken for odom/base_link,
           and it is never put on /tf. -->
      <plugin filename="gz-sim-odometry-publisher-system"
              name="gz::sim::systems::OdometryPublisher">
        <odom_frame>sim_world</odom_frame>
        <robot_base_frame>sim_base_link</robot_base_frame>
        <odom_topic>/sim/ground_truth</odom_topic>
        <odom_publish_frequency>50</odom_publish_frequency>
        <dimensions>3</dimensions>
      </plugin>
    </gazebo>
  </xacro:if>

  <!-- Contact / friction tuning (legacy gazebo-reference tags) -->
  <gazebo reference="chassis">
    <mu1 value="0.0"/>
    <mu2 value="0.0"/>
    <kp  value="10000000.0"/>
    <kd  value="1.0"/>
  </gazebo>

  <gazebo reference="left_rear_wheel">
    <mu1 value="1.0"/><mu2 value="1.0"/>
    <kp value="10000000.0"/><kd value="1.0"/>
    <fdir1 value="1 0 0"/>
  </gazebo>
  <gazebo reference="right_rear_wheel">
    <mu1 value="1.0"/><mu2 value="1.0"/>
    <kp value="10000000.0"/><kd value="1.0"/>
    <fdir1 value="1 0 0"/>
  </gazebo>
  <gazebo reference="left_front_wheel">
    <mu1 value="1.0"/><mu2 value="1.0"/>
    <kp value="10000000.0"/><kd value="1.0"/>
    <fdir1 value="0 0 1"/>
  </gazebo>
  <gazebo reference="right_front_wheel">
    <mu1 value="1.0"/><mu2 value="1.0"/>
    <kp value="10000000.0"/><kd value="1.0"/>
    <fdir1 value="0 0 1"/>
  </gazebo>

</robot>
