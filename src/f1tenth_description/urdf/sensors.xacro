<?xml version="1.0"?>
<!--
  sensors.xacro - sensor links + Gazebo Harmonic sensor plugins.

  NEW relative to msauber (which had only a stereo "front camera" and no LiDAR/
  IMU in its URDF). Frame names and mount poses match the real F1TENTH stack:

    base_link -> laser              @ ( 0.12, 0, 0.20), yaw=0   (Hokuyo, front-facing)
    base_link -> imu                @ ( 0,    0, 0   )          (VESC IMU @ base_link)
    base_link -> zed2_camera_link   @ ( 0.12, 0, 0.15), yaw=0   (ZED2, front-facing)
                 -> zed2_left_camera_frame -> zed2_left_camera_optical_frame

  laser matches description.launch.py's real-hardware static_baselink_to_laser
  (the front-facing remount; its numbers are ruler-measured placeholders, see
  that file). The sim must scan from the pose the Thor's TF claims, or every
  scan is misregistered. imu matches vesc.launch.py's identity base_link->imu.

  Gazebo tags use the Harmonic conventions: <gz_frame_id> (Fortress spelled it
  <gz_frame_id>), rendered by the world's gz::sim::systems::Sensors / ::Imu
  systems. <gazebo> blocks are ignored by robot_state_publisher, so this file is
  harmless on the real robot. The IMU's gz frame id never reaches the stack:
  f1tenth_sim's drive_bridge restamps the message with the real driver's empty
  frame_id (output/sim_port_report.md, D3).

  The ZED2 camera/depth sensors are only rendered with enable_camera_mock:=true
  (default false): two 1280x720 streams at 30 Hz cost more than the sim host's
  GPU and the LAN should carry, and nothing consumes them yet.
-->
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="roboracer">

  <xacro:if value="$(arg enable_sensors)">

    <!-- ============================ LiDAR =============================== -->
    <link name="laser">
      <inertial><xacro:sensor_inertial_params /></inertial>
      <visual>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <geometry><cylinder radius="0.025" length="0.05"/></geometry>
        <material name="grey"/>
      </visual>
    </link>
    <joint name="laser_joint" type="fixed">
      <parent link="base_link"/>
      <child link="laser"/>
      <!-- Front-facing; same values as description.launch.py's static_baselink_to_laser. -->
      <origin xyz="0.12 0.0 0.20" rpy="0 0 0"/>
    </joint>

    <gazebo reference="laser">
      <sensor name="hokuyo" type="gpu_lidar">
        <topic>scan</topic>
        <gz_frame_id>laser</gz_frame_id>
        <update_rate>40</update_rate>
        <always_on>true</always_on>
        <visualize>true</visualize>
        <lidar>
          <scan>
            <horizontal>
              <!-- 270 deg FOV: [-135 deg, +135 deg] = [-2.3562, 2.3562] rad -->
              <samples>1081</samples>
              <resolution>1</resolution>
              <min_angle>-2.3561945</min_angle>
              <max_angle>2.3561945</max_angle>
            </horizontal>
            <vertical>
              <samples>1</samples>
              <min_angle>0</min_angle>
              <max_angle>0</max_angle>
            </vertical>
          </scan>
          <range>
            <min>0.1</min>
            <max>10.0</max>
            <resolution>0.01</resolution>
          </range>
        </lidar>
      </sensor>
    </gazebo>

    <!-- ============================= IMU ================================ -->
    <link name="imu">
      <inertial><xacro:sensor_inertial_params /></inertial>
      <visual>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <geometry><box size="0.02 0.02 0.01"/></geometry>
        <material name="blue"/>
      </visual>
    </link>
    <joint name="imu_joint" type="fixed">
      <parent link="base_link"/>
      <child link="imu"/>
      <origin xyz="0.0 0.0 0.0" rpy="0 0 0"/>
    </joint>

    <gazebo reference="imu">
      <sensor name="imu_sensor" type="imu">
        <topic>sensors/imu/raw</topic>
        <gz_frame_id>imu</gz_frame_id>
        <!-- vesc_driver polls the IMU every 20 ms, so ~50 Hz on the car. -->
        <update_rate>50</update_rate>
        <always_on>true</always_on>
      </sensor>
    </gazebo>

    <!-- ====================== ZED2 mock camera ========================= -->
    <!-- Mount link (root of the ZED URDF chain on the real robot) -->
    <link name="zed2_camera_link">
      <inertial><xacro:sensor_inertial_params /></inertial>
      <visual>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <geometry><box size="0.03 0.175 0.03"/></geometry>
        <material name="grey"/>
      </visual>
    </link>
    <joint name="zed2_camera_joint" type="fixed">
      <parent link="base_link"/>
      <child link="zed2_camera_link"/>
      <origin xyz="0.12 0.0 0.15" rpy="0 0 0"/>
    </joint>

    <!-- Left lens frame (ZED2 baseline ~0.06 m, left = +y) -->
    <link name="zed2_left_camera_frame">
      <inertial><xacro:sensor_inertial_params /></inertial>
    </link>
    <joint name="zed2_left_camera_joint" type="fixed">
      <parent link="zed2_camera_link"/>
      <child link="zed2_left_camera_frame"/>
      <origin xyz="0.0 0.06 0.0" rpy="0 0 0"/>
    </joint>

    <!-- Optical frame: REP-103 optical convention (z forward, x right, y down) -->
    <link name="zed2_left_camera_optical_frame"/>
    <joint name="zed2_left_camera_optical_joint" type="fixed">
      <parent link="zed2_left_camera_frame"/>
      <child link="zed2_left_camera_optical_frame"/>
      <origin xyz="0 0 0" rpy="${-pi/2} 0 ${-pi/2}"/>
    </joint>

    <!-- RGB + depth sensors. Image headers carry the optical frame id. -->
    <xacro:if value="$(arg enable_camera_mock)">
    <gazebo reference="zed2_left_camera_frame">
      <sensor name="zed2_rgb" type="camera">
        <topic>zed2/zed_node/rgb/image_rect_color</topic>
        <gz_frame_id>zed2_left_camera_optical_frame</gz_frame_id>
        <update_rate>30</update_rate>
        <always_on>true</always_on>
        <visualize>false</visualize>
        <camera>
          <!-- ZED2 HD720 left lens: ~101 deg HFOV -->
          <horizontal_fov>1.7633</horizontal_fov>
          <image>
            <width>1280</width>
            <height>720</height>
            <format>R8G8B8</format>
          </image>
          <clip>
            <near>0.05</near>
            <far>50.0</far>
          </clip>
        </camera>
      </sensor>
      <sensor name="zed2_depth" type="depth_camera">
        <topic>zed2/zed_node/depth/depth_registered</topic>
        <gz_frame_id>zed2_left_camera_optical_frame</gz_frame_id>
        <update_rate>30</update_rate>
        <always_on>true</always_on>
        <visualize>false</visualize>
        <camera>
          <horizontal_fov>1.7633</horizontal_fov>
          <image>
            <width>1280</width>
            <height>720</height>
            <format>R_FLOAT32</format>
          </image>
          <clip>
            <!-- ZED2 depth range -->
            <near>0.3</near>
            <far>20.0</far>
          </clip>
        </camera>
      </sensor>
    </gazebo>
    </xacro:if>

  </xacro:if>

</robot>
