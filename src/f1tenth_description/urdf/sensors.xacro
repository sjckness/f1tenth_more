<?xml version="1.0"?>
<!--
  sensors.xacro - LiDAR, IMU and ZED 2i links + Gazebo Harmonic sensors.

  Sim only (enable_sensors:=true). On the car the same frames come from:
    base_link -> laser             description.launch.py   static_baselink_to_laser
    base_link -> imu               vesc.launch.py          static_baselink_to_imu
    base_link -> zed2_camera_link  camera.launch.py        static_baselink_to_zed2
    zed2_camera_link -> ...        the ZED wrapper's robot_state_publisher
                                   (zed_macro.urdf.xacro, camera_name zed2,
                                   camera_model zed2i)

  The LiDAR and ZED 2i MOUNT POSES are now SIM-SPECIFIC and deliberately NOT
  copies of the car's TFs: they come from config/sim_sensor_mounts.yaml (the
  single source of truth), loaded below. The car's real base_link->laser
  (0.12, 0, 0.20) and base_link->zed2_camera_link (0.12, 0, 0.15) are unchanged.
  The IMU stays at base_link (identity) on both. test_sim_matches_car_config.py
  checks the URDF mounts equal the yaml and that the car's TFs still hold.

  The mount numbers assume base_link at the rear axle on the ground (this URDF);
  description.launch.py's docstring measured the car TFs from a "centred between
  the axles, 0.07 m up" base_link instead. That disagreement is real-car item
  G13 (output/sim_port_report.md); the sim follows this URDF's base_link.

  The sim's TF never reaches the stack (f1tenth_sim's robot_state_publisher
  publishes on /sim/tf). In sim mode the Thor publishes these frames itself, with
  the SAME sim_sensor_mounts.yaml numbers: sim_hardware_tf.launch.py (imu),
  description.launch.py (laser, sim branch) and
  f1tenth_perception/sim_camera_tf.launch.py (the ZED tree).

  Gazebo tags are ignored by robot_state_publisher, so nothing here affects the
  car.
-->
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="roboracer">

  <!-- ===== mount poses: SIM-SPECIFIC, from config/sim_sensor_mounts.yaml
       (single source of truth; see header). NOT the car's TFs. ===== -->
  <xacro:property name="sim_mounts"
                  value="${xacro.load_yaml(pkg_share + '/config/sim_sensor_mounts.yaml')}" />
  <xacro:property name="laser_xyz"
                  value="${sim_mounts['laser']['xyz'][0]} ${sim_mounts['laser']['xyz'][1]} ${sim_mounts['laser']['xyz'][2]}" />
  <xacro:property name="imu_xyz"   value="0.0 0.0 0.0" />     <!-- identity, like the car -->
  <xacro:property name="zed_xyz"
                  value="${sim_mounts['zed2_camera_link']['xyz'][0]} ${sim_mounts['zed2_camera_link']['xyz'][1]} ${sim_mounts['zed2_camera_link']['xyz'][2]}" />

  <!-- ===== ZED 2i internal geometry: zed_macro.urdf.xacro, model zed2i
       (zed-ros2-wrapper v5.4.1, the submodule's pinned commit 86171bc) ===== -->
  <xacro:property name="zed_baseline"         value="0.12" />
  <xacro:property name="zed_height"           value="0.03" />  <!-- macro value; mount -> centre = height/2 -->
  <xacro:property name="zed_bottom_slope"     value="0.0" />   <!-- zed2 has 0.05; zed2i is level -->
  <xacro:property name="zed_screw_offset_x"   value="-0.01" />
  <xacro:property name="zed_optical_offset_x" value="-0.01" />
  <!-- Housing 175.25 x 30.25 x 43.1 mm (Stereolabs ZED 2i datasheet) -->
  <xacro:property name="zed_box" value="0.03025 0.17525 0.0431" />

  <!-- ===== ZED 2i streams as the car publishes them (zed2_perception.yaml):
       HD720 grab, pub_resolution CUSTOM with pub_downscale_factor 2 -> 640x360,
       pub_frame_rate 30. HFOV of the rectified HD720 left image:
       2*atan(640 / 528 px) = 1.762 rad (~101 deg). ===== -->
  <xacro:property name="zed_width"      value="640" />
  <xacro:property name="zed_height_px"  value="360" />
  <xacro:property name="zed_rate"       value="30" />
  <xacro:property name="zed_hfov"       value="1.762" />
  <xacro:property name="zed_depth_min"  value="0.3" />   <!-- ZED 2i physical minimum -->
  <xacro:property name="zed_depth_max"  value="15.0" />  <!-- wrapper zed2i.yaml depth.max_depth -->

  <xacro:if value="$(arg enable_sensors)">

    <!-- ============================ LiDAR =============================== -->
    <!-- Hokuyo UST-10LX: 270 deg, 1081 beams (0.25 deg), 40 Hz, 0.06-10 m
         spec (0.1 m min here so the scan never hits its own housing). -->
    <link name="laser">
      <inertial><xacro:sensor_inertial_params /></inertial>
      <visual>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <geometry><mesh filename="${mesh_dir}/hokuyo.stl"/></geometry>
        <material name="dark_grey"/>
      </visual>
    </link>
    <joint name="laser_joint" type="fixed">
      <parent link="base_link"/>
      <child link="laser"/>
      <origin xyz="${laser_xyz}" rpy="0 0 0"/>
    </joint>

    <gazebo reference="laser">
      <sensor name="hokuyo" type="gpu_lidar">
        <topic>scan</topic>
        <gz_frame_id>laser</gz_frame_id>
        <update_rate>40</update_rate>
        <always_on>true</always_on>
        <visualize>true</visualize>
        <lidar>
          <scan>
            <horizontal>
              <!-- 270 deg FOV: [-135 deg, +135 deg] = [-2.3562, 2.3562] rad -->
              <samples>1081</samples>
              <resolution>1</resolution>
              <min_angle>-2.3561945</min_angle>
              <max_angle>2.3561945</max_angle>
            </horizontal>
            <vertical>
              <samples>1</samples>
              <min_angle>0</min_angle>
              <max_angle>0</max_angle>
            </vertical>
          </scan>
          <range>
            <min>0.1</min>
            <max>10.0</max>
            <resolution>0.01</resolution>
          </range>
        </lidar>
      </sensor>
    </gazebo>

    <!-- ============================= IMU ================================ -->
    <link name="imu">
      <inertial><xacro:sensor_inertial_params /></inertial>
      <visual>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <geometry><box size="0.02 0.02 0.01"/></geometry>
        <material name="blue"/>
      </visual>
    </link>
    <joint name="imu_joint" type="fixed">
      <parent link="base_link"/>
      <child link="imu"/>
      <origin xyz="${imu_xyz}" rpy="0 0 0"/>
    </joint>

    <gazebo reference="imu">
      <sensor name="imu_sensor" type="imu">
        <topic>sensors/imu/raw</topic>
        <gz_frame_id>imu</gz_frame_id>
        <!-- vesc_driver polls the IMU every 20 ms, so ~50 Hz on the car. -->
        <update_rate>50</update_rate>
        <always_on>true</always_on>
      </sensor>
    </gazebo>

    <!-- =========================== ZED 2i ============================== -->
    <!-- Same links, joints and names as the wrapper's zed_macro for
         camera_name zed2 / camera_model zed2i, so the sim tree is the car's. -->

    <!-- Mounting point (the threaded hole under the camera) -->
    <link name="zed2_camera_link"/>
    <joint name="zed2_camera_joint" type="fixed">
      <parent link="base_link"/>
      <child link="zed2_camera_link"/>
      <origin xyz="${zed_xyz}" rpy="0 0 0"/>
    </joint>

    <link name="zed2_camera_center">
      <inertial><xacro:sensor_inertial_params /></inertial>
      <visual>
        <!-- box bottom on the mounting plane, shifted like the wrapper's mesh -->
        <origin xyz="${zed_screw_offset_x} 0 ${0.0431/2 - zed_height/2}" rpy="0 0 0"/>
        <geometry><box size="${zed_box}"/></geometry>
        <material name="dark_grey"/>
      </visual>
    </link>
    <joint name="zed2_camera_center_joint" type="fixed">
      <parent link="zed2_camera_link"/>
      <child link="zed2_camera_center"/>
      <origin xyz="0 0 ${zed_height/2}" rpy="0 ${zed_bottom_slope} 0"/>
    </joint>

    <link name="zed2_left_camera_frame">
      <inertial><xacro:sensor_inertial_params /></inertial>
    </link>
    <joint name="zed2_left_camera_joint" type="fixed">
      <parent link="zed2_camera_center"/>
      <child link="zed2_left_camera_frame"/>
      <origin xyz="${zed_optical_offset_x} ${zed_baseline/2} 0" rpy="0 0 0"/>
    </joint>

    <!-- REP-103 optical convention (z forward, x right, y down). Wrapper v5
         name: *_frame_optical (v4 called it *_optical_frame). -->
    <link name="zed2_left_camera_frame_optical"/>
    <joint name="zed2_left_camera_joint_optical" type="fixed">
      <parent link="zed2_left_camera_frame"/>
      <child link="zed2_left_camera_frame_optical"/>
      <origin xyz="0 0 0" rpy="${-pi/2} 0 ${-pi/2}"/>
    </joint>

    <link name="zed2_right_camera_frame"/>
    <joint name="zed2_right_camera_joint" type="fixed">
      <parent link="zed2_camera_center"/>
      <child link="zed2_right_camera_frame"/>
      <origin xyz="${zed_optical_offset_x} ${-zed_baseline/2} 0" rpy="0 0 0"/>
    </joint>

    <link name="zed2_right_camera_frame_optical"/>
    <joint name="zed2_right_camera_joint_optical" type="fixed">
      <parent link="zed2_right_camera_frame"/>
      <child link="zed2_right_camera_frame_optical"/>
      <origin xyz="0 0 0" rpy="${-pi/2} 0 ${-pi/2}"/>
    </joint>

    <!-- RGB + registered depth from the left lens, stamped with the left
         optical frame like the wrapper. gz topics are sim-internal (/sim/zed2/*);
         ros_gz_bridge.yaml maps them onto the topics the stack reads:
           /sim/zed2/rgb/image         -> /camera/image_raw
           /sim/zed2/rgb/camera_info   -> /camera/camera_info
           /sim/zed2/depth/image       -> /zed2/zed_node/depth/depth_registered
           /sim/zed2/depth/camera_info -> /zed2/zed_node/depth/camera_info -->
    <xacro:if value="$(arg enable_camera_mock)">
    <gazebo reference="zed2_left_camera_frame">
      <sensor name="zed2_rgb" type="camera">
        <topic>/sim/zed2/rgb/image</topic>
        <gz_frame_id>zed2_left_camera_frame_optical</gz_frame_id>
        <update_rate>${zed_rate}</update_rate>
        <always_on>true</always_on>
        <visualize>false</visualize>
        <camera>
          <camera_info_topic>/sim/zed2/rgb/camera_info</camera_info_topic>
          <horizontal_fov>${zed_hfov}</horizontal_fov>
          <image>
            <width>${zed_width}</width>
            <height>${zed_height_px}</height>
            <format>R8G8B8</format>
          </image>
          <clip>
            <near>0.05</near>
            <far>50.0</far>
          </clip>
        </camera>
      </sensor>
      <sensor name="zed2_depth" type="depth_camera">
        <topic>/sim/zed2/depth/image</topic>
        <gz_frame_id>zed2_left_camera_frame_optical</gz_frame_id>
        <update_rate>${zed_rate}</update_rate>
        <always_on>true</always_on>
        <visualize>false</visualize>
        <camera>
          <camera_info_topic>/sim/zed2/depth/camera_info</camera_info_topic>
          <horizontal_fov>${zed_hfov}</horizontal_fov>
          <image>
            <width>${zed_width}</width>
            <height>${zed_height_px}</height>
            <format>R_FLOAT32</format>
          </image>
          <clip>
            <near>${zed_depth_min}</near>
            <far>${zed_depth_max}</far>
          </clip>
        </camera>
      </sensor>
    </gazebo>
    </xacro:if>

  </xacro:if>

</robot>
