<?xml version="1.0" ?>
<!--
  roboracer.urdf.xacro - F1TENTH vehicle description (the only top-level model).

  Used by the stack's robot_state_publisher on the car (description.launch.py,
  use_sim:=false enable_sensors:=false: body + wheels only) and by f1tenth_sim's
  private robot_state_publisher (use_sim:=true enable_sensors:=true).

  Ported from msauber_stack/msauber_description. The body is still the msauber
  "Sauber" shell mesh, but it is now scaled into the F1TENTH reference envelope
  below, so the visual, the wheels and the sim physics all have F1TENTH size.

  ===================== single-source dimensions =====================
  F1TENTH reference values (f1tenth_simulator racecar.xacro / params.yaml, the
  same numbers f1tenth_gym uses). The car's own wheelbase has never been
  measured: vesc.yaml and the MPC use 0.305 (docs/DIAGNOSTICS.md, backlog P2).
  Every dimension lives here once; core.xacro, sensors.xacro and the sim's
  controllers.yaml / drive_bridge derive from it (test_sim_matches_car_config.py
  checks the sim side).

  base_link: on the ground plane, at the rear axle, laterally centred. That is
  the point the odometry (vesc_to_odom's bicycle model, the sim's
  ackermann_steering_controller) integrates, and the frame the EKF drives.

  Args:
    pkg_share          - absolute path to this package's share dir (for mesh_dir).
    use_sim            - true to emit the gz_ros2_control + ground-truth gazebo plugins.
    enable_sensors     - true to include the LiDAR / IMU / ZED 2i links. Sim only:
                         on the car those frames come from static TF publishers
                         and the ZED wrapper (see description.launch.py).
    enable_camera_mock - true to also render the ZED 2i RGB + depth gz sensors
                         (sim only; f1tenth_sim's `camera` arg, default on).
    control_config     - path to the ros2_control controllers.yaml (f1tenth_sim).
-->
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="roboracer">

  <xacro:arg name="pkg_share"          default="$(find f1tenth_description)" />
  <xacro:arg name="use_sim"            default="true" />
  <xacro:arg name="enable_sensors"     default="true" />
  <xacro:arg name="enable_camera_mock" default="false" />
  <xacro:arg name="control_config"     default="" />

  <xacro:property name="pkg_share" value="$(arg pkg_share)" />
  <xacro:property name="mesh_dir"  value="${pkg_share}/meshes" />

  <!-- Wheels and axles (F1TENTH reference). -->
  <xacro:property name="wheelbase"    value="0.3302" />  <!-- rear axle -> front axle -->
  <xacro:property name="track"        value="0.2413" />  <!-- wheel centre -> wheel centre -->
  <xacro:property name="wheel_radius" value="0.0508" />
  <xacro:property name="wheel_width"  value="0.0381" />
  <!-- Body envelope (F1TENTH reference: bottom 0.04 m, height 0.1 m). The body
       is as wide as the outside of the wheels. -->
  <xacro:property name="body_bottom"  value="0.04" />    <!-- above ground -->
  <xacro:property name="body_top"     value="0.14" />    <!-- above ground -->
  <xacro:property name="body_width"   value="${track + wheel_width}" />
  <xacro:property name="steer_limit"  value="0.4" />     <!-- hinge joint limit [rad] -->

  <xacro:include filename="${pkg_share}/urdf/macros.xacro" />
  <xacro:include filename="${pkg_share}/urdf/core.xacro" />
  <xacro:include filename="${pkg_share}/urdf/sensors.xacro" />
  <xacro:include filename="${pkg_share}/urdf/ros2_control.xacro" />

</robot>
