<?xml version="1.0" ?>
<!--
  roboracer.urdf.xacro - F1TENTH vehicle description.

  Ported from msauber_stack/msauber_description (ROS 2 Jazzy + Gazebo Harmonic)
  to ROS 2 Humble + Gazebo Fortress (ignition-fortress). Key differences vs the
  source:
    * Frames use the canonical F1TENTH names (base_link, laser, imu,
      zed2_camera_link, ...) so the model is a drop-in for f1tenth_bringup and
      f1tenth_perception - NOT the 'sauber_*' prefixed names.
    * ros2_control hardware is ign_ros2_control/IgnitionSystem (was
      gz_ros2_control/GazeboSimSystem).
    * The stereo "front camera" is replaced by a ZED2 mock (RGB + depth +
      camera_info on the zed2 optical frame).
    * A 2D Hokuyo-like LiDAR (/scan) and an IMU (/sensors/imu/raw) are added
      (the source had neither in the URDF).

  Args:
    pkg_share      - absolute path to this package's share dir (for mesh_dir).
    use_sim        - true to emit the ign_ros2_control gazebo plugin + sensors.
    enable_sensors - true to include the LiDAR / camera / IMU sensor links.
    control_config - path to the ros2_control controllers.yaml (f1tenth_sim).
-->
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="roboracer">

  <xacro:arg name="pkg_share"      default="$(find f1tenth_description)" />
  <xacro:arg name="use_sim"        default="true" />
  <xacro:arg name="enable_sensors" default="true" />
  <xacro:arg name="control_config" default="" />

  <xacro:property name="pkg_share" value="$(arg pkg_share)" />
  <xacro:property name="mesh_dir"  value="${pkg_share}/meshes" />

  <xacro:include filename="${pkg_share}/urdf/macros.xacro" />
  <xacro:include filename="${pkg_share}/urdf/core.xacro" />
  <xacro:include filename="${pkg_share}/urdf/sensors.xacro" />
  <xacro:include filename="${pkg_share}/urdf/ros2_control.xacro" />

</robot>
