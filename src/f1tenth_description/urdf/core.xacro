<?xml version="1.0" ?>
<!--
  core.xacro - chassis, wheels and steering hinges for the F1TENTH car.
  Ported from msauber_description/urdf/core.xacro. Link/joint names are the
  canonical unprefixed F1TENTH names (base_link is the kinematic root).
  Geometry (wheelbase 0.325 m, track 0.2 m) is kept as-ported from msauber.
-->
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="roboracer">

  <!-- Kinematic root -->
  <link name="base_link"/>

  <link name="chassis">
    <visual>
      <xacro:chassis_geometry/>
      <material name="red" />
    </visual>
  </link>

  <joint name="base_link_joint" type="fixed">
    <origin xyz="0 0 0.05" rpy="0 0 0" />
    <parent link="base_link" />
    <child link="chassis" />
  </joint>

  <link name="chassis_inertia">
    <inertial>
      <xacro:chassis_inertial_params />
    </inertial>
  </link>

  <joint name="chassis_inertia_joint" type="fixed">
    <origin xyz="0 0 0" rpy="0 0 0" />
    <parent link="chassis" />
    <child link="chassis_inertia" />
  </joint>

  <!-- Left rear wheel (traction) -->
  <link name="left_rear_wheel">
    <inertial><xacro:left_wheels_inertial_params /></inertial>
    <visual><xacro:left_rear_wheel_geometry /><material name="black" /></visual>
    <collision><xacro:left_wheels_collision_geometry /></collision>
  </link>
  <joint name="left_rear_wheel_joint" type="continuous">
    <origin xyz="0 0.1 0" rpy="1.5708 0 0" />
    <parent link="chassis" />
    <child link="left_rear_wheel" />
    <axis xyz="0 0 -1" />
    <limit effort="100" velocity="100" />
  </joint>

  <!-- Right rear wheel (traction) -->
  <link name="right_rear_wheel">
    <inertial><xacro:right_wheels_inertial_params /></inertial>
    <visual><xacro:right_rear_wheel_geometry /><material name="black" /></visual>
    <collision><xacro:right_wheels_collision_geometry /></collision>
  </link>
  <joint name="right_rear_wheel_joint" type="continuous">
    <origin xyz="0 -0.1 0" rpy="1.5708 0 0" />
    <parent link="chassis" />
    <child link="right_rear_wheel" />
    <axis xyz="0 0 -1" />
    <limit effort="100" velocity="100" />
  </joint>

  <!-- Left steering hinge -->
  <link name="left_steering_hinge">
    <inertial><xacro:steering_hinge_inertial_params /></inertial>
    <visual><xacro:left_steering_hinge_geometry /><material name="grey" /></visual>
  </link>
  <joint name="left_steering_hinge_joint" type="revolute">
    <origin xyz="0.325 0.1 0" rpy="0 1.5708 0" />
    <parent link="chassis" />
    <child link="left_steering_hinge" />
    <axis xyz="-1 0 0" />
    <limit lower="-0.4" upper="0.4" effort="10" velocity="10" />
  </joint>

  <!-- Right steering hinge -->
  <link name="right_steering_hinge">
    <inertial><xacro:steering_hinge_inertial_params /></inertial>
    <visual><xacro:right_steering_hinge_geometry /><material name="grey" /></visual>
  </link>
  <joint name="right_steering_hinge_joint" type="revolute">
    <origin xyz="0.325 -0.1 0" rpy="0 1.5708 0" />
    <parent link="chassis" />
    <child link="right_steering_hinge" />
    <axis xyz="-1 0 0" />
    <limit lower="-0.4" upper="0.4" effort="10" velocity="10" />
  </joint>

  <!-- Left front wheel (steered) -->
  <link name="left_front_wheel">
    <inertial><xacro:left_wheels_inertial_params /></inertial>
    <visual><xacro:left_front_wheel_geometry /><material name="black" /></visual>
    <collision><xacro:left_wheels_collision_geometry /></collision>
  </link>
  <joint name="left_front_wheel_joint" type="continuous">
    <origin xyz="0 0 0" rpy="1.5708 0 0" />
    <parent link="left_steering_hinge" />
    <child link="left_front_wheel" />
    <axis xyz="0 0 -1" />
    <limit effort="100" velocity="100" />
  </joint>

  <!-- Right front wheel (steered) -->
  <link name="right_front_wheel">
    <inertial><xacro:right_wheels_inertial_params /></inertial>
    <visual><xacro:right_front_wheel_geometry /><material name="black" /></visual>
    <collision><xacro:right_wheels_collision_geometry /></collision>
  </link>
  <joint name="right_front_wheel_joint" type="continuous">
    <origin xyz="0 0 0" rpy="1.5708 0 0" />
    <parent link="right_steering_hinge" />
    <child link="right_front_wheel" />
    <axis xyz="0 0 -1" />
    <limit effort="100" velocity="100"/>
  </joint>

</robot>
