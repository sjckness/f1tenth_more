<?xml version="1.0" ?>
<!--
  core.xacro - base_link, chassis, wheels and steering hinges.

  base_link is the kinematic root: on the ground, at the rear axle, laterally
  centred. chassis sits at axle height (wheel_radius) above it; the wheel and
  hinge joints hang off chassis at the axle positions.

  Link/joint names are the canonical unprefixed F1TENTH names and must not
  change: ros2_control.xacro, controllers.yaml and the gazebo <reference>
  friction tags all address them by name.

  Wheel joint geometry: the wheel meshes (left_wheel.stl / right_wheel.stl,
  r 0.05, width 0.045, axle along the mesh z) are scaled to wheel_radius /
  wheel_width. Each extends OUTWARD from its joint, so the joint sits at
  y = +-(track - wheel_width)/2 and the tyre centre lands on +-track/2.
  Sign conventions (verified in the sim port, output/sim_port_report.md 2.2):
  hinge rpy (0, pi/2, 0) with axis -x, so + hinge angle = +yaw (left); wheel
  rpy (pi/2, 0, 0) with axis -z, so + wheel velocity rolls toward +x.
-->
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="roboracer">

  <xacro:property name="wheel_joint_y" value="${(track - wheel_width) / 2.0}" />
  <xacro:property name="wheel_mesh_scale"
                  value="${wheel_radius / 0.05} ${wheel_radius / 0.05} ${wheel_width / 0.045}" />

  <!-- Kinematic root. No base_footprint: base_link is already on the ground,
       and the stack never uses one (slam_toolbox_params.yaml base_frame). -->
  <link name="base_link"/>

  <link name="chassis">
    <visual>
      <xacro:chassis_geometry/>
      <material name="red" />
    </visual>
    <!-- Body box (between the wheels) so the car hits walls with its body, not
         only its tyres. mu = 0 in ros2_control.xacro: it slides, never drives. -->
    <collision>
      <origin xyz="${(body_front_x + body_rear_x) / 2.0} 0
                   ${(body_top + body_bottom) / 2.0 - wheel_radius}" rpy="0 0 0" />
      <geometry>
        <box size="${body_front_x - body_rear_x} ${track - wheel_width} ${body_top - body_bottom}" />
      </geometry>
    </collision>
  </link>

  <joint name="base_link_joint" type="fixed">
    <origin xyz="0 0 ${wheel_radius}" rpy="0 0 0" />
    <parent link="base_link" />
    <child link="chassis" />
  </joint>

  <link name="chassis_inertia">
    <inertial>
      <xacro:chassis_inertial_params />
    </inertial>
  </link>

  <joint name="chassis_inertia_joint" type="fixed">
    <origin xyz="0 0 0" rpy="0 0 0" />
    <parent link="chassis" />
    <child link="chassis_inertia" />
  </joint>

  <!-- One wheel. side: left|right. steer: true -> revolute steering hinge at
       (x, y) with the wheel on it; false -> wheel directly on the chassis. -->
  <xacro:macro name="wheel" params="side axle x steer">
    <xacro:property name="sign" value="${1 if side == 'left' else -1}" />
    <xacro:property name="y"    value="${sign * wheel_joint_y}" />
    <!-- left mesh spans z in [-w, 0], right mesh [0, +w]: both point outward -->
    <xacro:property name="z_off" value="${-sign * wheel_width / 2.0}" />

    <link name="${side}_${axle}_wheel">
      <inertial><xacro:wheel_inertial_params z_off="${z_off}" /></inertial>
      <visual>
        <origin xyz="0 0 0" rpy="0 0 0" />
        <geometry>
          <mesh filename="${mesh_dir}/${side}_wheel.stl" scale="${wheel_mesh_scale}" />
        </geometry>
        <material name="black" />
      </visual>
      <collision>
        <origin xyz="0 0 ${z_off}" rpy="0 0 0" />
        <geometry><cylinder length="${wheel_width}" radius="${wheel_radius}" /></geometry>
      </collision>
    </link>

    <xacro:if value="${steer}">
      <link name="${side}_steering_hinge">
        <inertial><xacro:steering_hinge_inertial_params /></inertial>
        <visual>
          <origin xyz="0 0 0" rpy="0 0 0" />
          <geometry><mesh filename="${mesh_dir}/hinge.stl" /></geometry>
          <material name="grey" />
        </visual>
      </link>
      <joint name="${side}_steering_hinge_joint" type="revolute">
        <origin xyz="${x} ${y} 0" rpy="0 ${pi/2} 0" />
        <parent link="chassis" />
        <child link="${side}_steering_hinge" />
        <axis xyz="-1 0 0" />
        <limit lower="${-steer_limit}" upper="${steer_limit}" effort="10" velocity="10" />
      </joint>
      <joint name="${side}_${axle}_wheel_joint" type="continuous">
        <origin xyz="0 0 0" rpy="${pi/2} 0 0" />
        <parent link="${side}_steering_hinge" />
        <child link="${side}_${axle}_wheel" />
        <axis xyz="0 0 -1" />
        <limit effort="100" velocity="100" />
      </joint>
    </xacro:if>
    <xacro:unless value="${steer}">
      <joint name="${side}_${axle}_wheel_joint" type="continuous">
        <origin xyz="${x} ${y} 0" rpy="${pi/2} 0 0" />
        <parent link="chassis" />
        <child link="${side}_${axle}_wheel" />
        <axis xyz="0 0 -1" />
        <limit effort="100" velocity="100" />
      </joint>
    </xacro:unless>
  </xacro:macro>

  <!-- Rear axle (traction) at x = 0, front axle (steered) at x = wheelbase -->
  <xacro:wheel side="left"  axle="rear"  x="0"            steer="false" />
  <xacro:wheel side="right" axle="rear"  x="0"            steer="false" />
  <xacro:wheel side="left"  axle="front" x="${wheelbase}" steer="true"  />
  <xacro:wheel side="right" axle="front" x="${wheelbase}" steer="true"  />

</robot>
