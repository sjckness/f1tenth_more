<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>sensors_stack_bringup</name>
  <version>0.1.0</version>
  <description>
    Launch files, configuration YAMLs and udev rules to bring up the F1TENTH
    sensor suite (ZED 2 stereo camera now; LiDAR later). Analogous to the launch
    and params layout of the vesc stack.
  </description>
  <maintainer email="andreas21steffens@gmail.com">Andreas Steffens</maintainer>
  <license>BSD</license>

  <buildtool_depend>ament_python</buildtool_depend>

  <!-- Runtime deps: the ZED SDK bridge and the nodes used by the launch file -->
  <exec_depend>zed_wrapper</exec_depend>
  <exec_depend>sensors_stack_description</exec_depend>
  <exec_depend>robot_state_publisher</exec_depend>
  <exec_depend>tf2_ros</exec_depend>
  <exec_depend>xacro</exec_depend>
  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>
  <!-- TODO: LiDAR — add the LiDAR driver package as an <exec_depend> here when added. -->

  <test_depend>ament_copyright</test_depend>
  <test_depend>ament_flake8</test_depend>
  <test_depend>ament_pep257</test_depend>
  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
