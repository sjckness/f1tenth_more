<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>f1tenth_localization</name>
  <version>0.0.0</version>
  <description>Localization (EKF / state estimation) for the F1TENTH vehicle. Owns
  robot_localization EKF bringup via launch/ekf.launch.py.</description>
  <maintainer email="andreas21steffens@gmail.com">andreas</maintainer>
  <license>MIT</license>

  <buildtool_depend>ament_python</buildtool_depend>

  <exec_depend>robot_localization</exec_depend>
  <exec_depend>ament_index_python</exec_depend>
  <exec_depend>ros2launch</exec_depend>
  <exec_depend>rclpy</exec_depend>
  <exec_depend>nav_msgs</exec_depend>
  <exec_depend>geometry_msgs</exec_depend>
  <exec_depend>tf2_ros</exec_depend>
  <!-- localization.launch.py includes f1tenth_description's description.launch.py
       (robot_state_publisher + static base_link -> laser TF) as part of the same
       restartable group. -->
  <exec_depend>f1tenth_description</exec_depend>
  <!-- param_defaults.py: shared launch-param defaults (see f1tenth_params/config/
       stack_params.yaml). f1tenth_params is a dependency-free leaf package;
       depending on it here (not f1tenth_bringup) avoids a build-order cycle,
       since f1tenth_bringup itself includes this package's launch file. -->
  <exec_depend>f1tenth_params</exec_depend>

  <test_depend>ament_copyright</test_depend>
  <test_depend>ament_flake8</test_depend>
  <test_depend>ament_pep257</test_depend>
  <test_depend>python3-pytest</test_depend>
  <!-- test_ekf_global_config.py loads ekf.yaml/ekf_global.yaml directly to
       confirm non-colliding frame ownership - test-only use, unlike
       f1tenth_params'/f1tenth_bringup's own exec_depend (they parse yaml
       at runtime, this package doesn't). -->
  <test_depend>python3-yaml</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
