<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>llm</name>
  <version>0.0.1</version>
  <description>F1TENTH LLM-based tooling (MPC tuner) and the llama-server bringup
  (launch/llm.launch.py) that hosts it. The only package inside f1tenth_intelligence.</description>
  <maintainer email="andreas21steffens@gmail.com">andreas</maintainer>
  <license>MIT</license>

  <buildtool_depend>ament_python</buildtool_depend>

  <depend>rclpy</depend>
  <depend>nav_msgs</depend>
  <depend>std_msgs</depend>
  <depend>ackermann_msgs</depend>

  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>
  <exec_depend>ament_index_python</exec_depend>
  <!-- HTTP client used by llm_mpc_tuner_node to talk to llama-server's /completion endpoint -->
  <exec_depend>python3-requests</exec_depend>
  <!-- param_defaults.py: shared launch-param defaults (see f1tenth_params/config/
       stack_params.yaml). f1tenth_params is a dependency-free leaf package;
       depending on it here (not f1tenth_bringup) avoids a build-order cycle,
       since f1tenth_bringup itself includes this package's launch file. -->
  <exec_depend>f1tenth_params</exec_depend>

  <test_depend>ament_copyright</test_depend>
  <test_depend>ament_flake8</test_depend>
  <test_depend>ament_pep257</test_depend>
  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
