<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>llm</name>
  <version>0.0.1</version>
  <description>F1TENTH LLM-based tooling (natural-language mission planner) and the
  llama-server bringup (launch/llm.launch.py) that hosts it. The only package inside
  f1tenth_intelligence.</description>
  <maintainer email="andreas21steffens@gmail.com">andreas</maintainer>
  <license>MIT</license>

  <buildtool_depend>ament_python</buildtool_depend>

  <!-- nav_msgs/ackermann_msgs/std_msgs all dropped along with
       llm_mpc_tuner_node.py's own removal (see git history): nav_msgs/
       ackermann_msgs (Odometry sub, AckermannDriveStamped stop_topic pub)
       were exclusively that node's; std_msgs turned out to ALSO be dead
       already at that point (llm_planner_node's own last std_msgs/String
       use, the old /corridor_cmd publisher, was removed in an earlier
       pass; the dependency just never got cleaned up until this audit).
       Confirmed by grep across every .py file in this package before
       removing any of the three. -->
  <depend>rclpy</depend>
  <depend>std_srvs</depend>
  <!-- LoadMission.srv, used by llm_planner_node's /mission/load_mission client
       (start_mission/abort_mission are plain std_srvs/Trigger, already covered
       above); confirmed against f1tenth_behavior's own package.xml, which
       depends on f1tenth_messages for the same .srv/.msg family (mission/
       loader.py). -->
  <depend>f1tenth_messages</depend>

  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>
  <exec_depend>ament_index_python</exec_depend>
  <!-- HTTP client used by llm_planner_node's own get_plan_from_llm() to talk
       to llama-server's /completion endpoint. Previously shared with
       llm_mpc_tuner_node.ask_llm() (the same backend, same request
       pattern); that node is gone now (see git history), but this
       dependency stays: llm_planner_node still needs it on its own. -->
  <exec_depend>python3-requests</exec_depend>
  <!-- get_package_share_directory('f1tenth_behavior') at runtime, to write
       LLM-generated mission JSON files under its installed missions/
       directory (see llm_planner_node._write_mission_file) and to reach the
       real mission service names (/mission/load_mission etc., owned by
       f1tenth_behavior's MissionLoader) this node's clients target. No
       Python import from f1tenth_behavior itself; only its installed
       share directory and its ROS service names. -->
  <exec_depend>f1tenth_behavior</exec_depend>
  <!-- param_defaults.py: shared launch-param defaults (see f1tenth_params/config/
       stack_params.yaml). f1tenth_params is a dependency-free leaf package;
       depending on it here (not f1tenth_bringup) avoids a build-order cycle,
       since f1tenth_bringup itself includes this package's launch file. -->
  <exec_depend>f1tenth_params</exec_depend>

  <test_depend>ament_copyright</test_depend>
  <test_depend>ament_flake8</test_depend>
  <test_depend>ament_pep257</test_depend>
  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
