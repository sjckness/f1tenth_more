# f1tenth_telegram as a systemd USER unit on linus. Not installed by anything:
#   mkdir -p ~/.config/systemd/user
#   cp systemd/f1tenth-telegram.service ~/.config/systemd/user/
#   systemctl --user daemon-reload
#   systemctl --user enable --now f1tenth-telegram
#   sudo loginctl enable-linger andreas     # keep it running without a login
#   journalctl --user -u f1tenth-telegram -f
# One polling process per bot token: never run this unit and a second copy
# (another machine, a terminal) with the same token. See README.md.

[Unit]
Description=F1Tenth Telegram control panel (f1tenth_telegram)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
# The token: TELEGRAM_BOT_TOKEN=... in a chmod 600 file outside the repo.
EnvironmentFile=%h/.config/f1tenth_telegram/env
# The venv that has python-telegram-bot (README.md).
Environment=PYTHON=%h/.local/share/f1tenth_telegram/venv/bin/python
Environment=PYTHONUNBUFFERED=1
ExecStart=%h/dev_ws/f1tenth_more_telegram/src/f1tenth_telegram/bin/f1tenth_telegram --config %h/dev_ws/f1tenth_more_telegram/src/f1tenth_telegram/config/telegram.yaml
Restart=on-failure
RestartSec=10

[Install]
WantedBy=default.target
