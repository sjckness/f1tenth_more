<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>f1tenth_more</name>
  <version>0.0.1</version>
  <description>Top-level metapackage for the F1TENTH (roboracer) autonomous racing stack. Aggregates all first-party packages.</description>
  <maintainer email="andreas21steffens@gmail.com">andreas</maintainer>
  <license>MIT</license>

  <buildtool_depend>ament_python</buildtool_depend>

  <exec_depend>f1tenth_bringup</exec_depend>
  <exec_depend>f1tenth_description</exec_depend>
  <exec_depend>f1tenth_hardware</exec_depend>
  <exec_depend>f1tenth_perception</exec_depend>
  <exec_depend>f1tenth_localization</exec_depend>
  <exec_depend>f1tenth_navigation</exec_depend>
  <exec_depend>f1tenth_control</exec_depend>
  <exec_depend>llm</exec_depend>
  <exec_depend>f1tenth_params</exec_depend>
  <!-- Previously missing from this list (flagged in the Phase 0 workspace audit);
       transitively pulled in via f1tenth_bringup's own dependencies either way, so
       this was a documentation-completeness gap, not a build-breaking one. -->
  <exec_depend>f1tenth_behavior</exec_depend>
  <exec_depend>f1tenth_diagnostics</exec_depend>
  <exec_depend>f1tenth_messages</exec_depend>
  <!-- f1tenth_sim is sim-only (no real-hardware dependency on it), but still a
       first-party package this metapackage's own description claims to aggregate. -->
  <exec_depend>f1tenth_sim</exec_depend>

  <test_depend>ament_copyright</test_depend>
  <test_depend>ament_flake8</test_depend>
  <test_depend>ament_pep257</test_depend>
  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
