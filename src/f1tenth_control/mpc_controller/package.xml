<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>mpc_controller</name>
  <version>0.0.0</version>
  <description>TODO: Package description</description>
  <maintainer email="fabiocar@todo.todo">fabiocar</maintainer>
  <license>TODO: License declaration</license>

  <depend>rclpy</depend>
  <depend>nav_msgs</depend>
  <depend>ackermann_msgs</depend>
  <depend>geometry_msgs</depend>
  <depend>std_msgs</depend>
  <depend>f1tenth_messages</depend>
  <!-- /scan (MPC_corr.py's scan_callback) for the wall_turn wall tracker
       (wall_tracker.py), plus the JointState/Imu imports that predate this
       entry and were never declared. Best-effort subscriber: it cannot
       back-pressure urg_node or the e-stop that also reads /scan. -->
  <depend>sensor_msgs</depend>
  <!-- /mpc/corridor_markers (MPC_corr.py's _publish_corridor_markers()):
       Foxglove/RViz visualization of the MPC's own soft reference corridor. -->
  <depend>visualization_msgs</depend>
  <!-- map <-> odom lookups (MPC_corr.py's _lookup_map_odom()), for the
       frozen straight-move anchor's drift correction, and the static
       base_link <- laser edge of the wall tracker. The control loop's own
       state stays odom frame, straight off the odometry topic; no other TF
       edge is consulted. -->
  <depend>tf2_ros</depend>
  <!-- TFMessage: the /tf_static-only buffer for base_link <- laser. -->
  <exec_depend>tf2_msgs</exec_depend>
  <!-- f1tenth_comms.tf_poll.PolledTf: map -> odom polled once per control
       tick from an unspun side node instead of a TransformListener taking
       every /tf message on this node's executor (R3, 2026-10-23). -->
  <exec_depend>f1tenth_comms</exec_depend>
  <!-- param_defaults.get_odom_topic(): single source of truth for the active
       odometry topic given localization_source (see f1tenth_params/config/
       stack_params.yaml). f1tenth_params is a dependency-free leaf package. -->
  <exec_depend>f1tenth_params</exec_depend>
  <!-- vehicle_frames.base_front_x(): the front bumper offset, read from the
       URDF base_front frame (the body box, the wall tracker's bumper and the
       obstacle-distance topics are measured from it). -->
  <exec_depend>f1tenth_description</exec_depend>
  <!-- ParameterDescriptor(read_only=True) for the LLM2 switch and whitelist
       (MPC_corr.py's _llm2_setup). Comes with rclpy, declared anyway. -->
  <exec_depend>rcl_interfaces</exec_depend>
  <!-- mpc_solver.py and cost_to_go.py import numpy and scipy (rosdep keys). -->
  <exec_depend>python3-numpy</exec_depend>
  <exec_depend>python3-scipy</exec_depend>

  <test_depend>ament_copyright</test_depend>
  <test_depend>ament_flake8</test_depend>
  <test_depend>ament_pep257</test_depend>
  <test_depend>python3-pytest</test_depend>
  <!-- test_go_to_object_end_to_end.py drives the real GoToObject and
       CheckStopCondition behaviours against this package's controller. Test
       only: nothing in mpc_controller imports f1tenth_behavior at run time. -->
  <test_depend>f1tenth_behavior</test_depend>
  <!-- test_llm_go_to_end_to_end.py starts the same chain from the LLM
       translator and the planner's mission writer. Test only as well. -->
  <test_depend>llm</test_depend>
  <!-- test_steering_limits.py resolves get_package_share_directory
       ('f1tenth_hardware') to read the real steering-limit config. Test
       only; no cycle (f1tenth_hardware does not depend back on this
       package). -->
  <test_depend>f1tenth_hardware</test_depend>
  <!-- NO dependency on f1tenth_mpc_core (src/rust/f1tenth_mpc_core,
       ament_cargo), deliberately: libf1tenth_mpc_core.so is the Rust corridor
       geometry (main-jazzy-rust R1) and RTI solver core (R2) mpc_native.py
       loads with ctypes only when corridor_impl or mpc_solver_impl is rust,
       found through ament_index in the sourced workspace, the
       corridor_perception / libextract_lines pattern. Any declared
       dependency, exec or test, makes this package unbuildable on a colcon
       without colcon-ros-cargo, where the Rust package cannot be built
       (measured 2026-10-23: "Failed to find ... f1tenth_mpc_core/package.sh",
       the CLAUDE.md Thor trap), and the MPC must build everywhere. Not built:
       corridor_impl / mpc_solver_impl rust refuse mpc_corr's start, and the
       rust corridor and solver tests skip. -->

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
