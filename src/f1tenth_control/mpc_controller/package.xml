<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>mpc_controller</name>
  <version>0.0.0</version>
  <description>TODO: Package description</description>
  <maintainer email="fabiocar@todo.todo">fabiocar</maintainer>
  <license>TODO: License declaration</license>

  <depend>rclpy</depend>
  <depend>nav_msgs</depend>
  <depend>ackermann_msgs</depend>
  <depend>geometry_msgs</depend>
  <depend>std_msgs</depend>
  <depend>f1tenth_messages</depend>
  <!-- /mpc/corridor_markers (MPC_corr.py's _publish_corridor_markers()) --
       Foxglove/RViz visualization of the MPC's own soft reference corridor. -->
  <depend>visualization_msgs</depend>
  <!-- param_defaults.get_odom_topic(): single source of truth for the active
       odometry topic given localization_source (see f1tenth_params/config/
       stack_params.yaml). f1tenth_params is a dependency-free leaf package. -->
  <exec_depend>f1tenth_params</exec_depend>

  <test_depend>ament_copyright</test_depend>
  <test_depend>ament_flake8</test_depend>
  <test_depend>ament_pep257</test_depend>
  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
