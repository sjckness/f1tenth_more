# f1tenth_ctl environment for the Isaac SIM on linus (ROS 2 Jazzy, one host).
#
# Same contract as ctl.env: bash, sourced with `set -a` on a minimal base
# environment for every process f1tenth_ctl starts. Use it with
#   F1T_CTL_ENV=<this file> f1tenth_ctl ...     or   f1tenth_ctl --env <this file> ...
#
# The stack is the car's own supervisor bringup with sim:=isaac, exactly what
# `scripts/sim/sim_isaac.sh stack` (--net local) runs. The simulator itself is
# not a managed process: it plays the car's hardware and is started separately,
#   scripts/sim/sim_isaac.sh isaac --scene base_room
# killall stops ROS processes of this user, not the Isaac container.
# The workspace is the checkout this file belongs to (colcon-built); it can be
# preset before sourcing this file (a wrapper env file that sets it):
: "${F1T_SIM_WS:=$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/../../.." && pwd)}"

set +u

# ---- ROS environment: exactly sim_isaac.sh's (ros_env, --net local) -------------
# The rule for every target (output/telegram/discovery.md): what f1tenth_ctl
# starts gets the same ROS environment as a shell on that target. For the sim
# that "shell" is sim_isaac.sh's ros_env: linus's apt-gap underlay
# (F1TENTH_EXTRA_SETUP, default ~/dev_ws/jc_env.sh, skipped if absent), domain
# 42, the Discovery Server on loopback, Fast DDS on loopback + shared memory
# (config/sim/dds/local.xml), and NO ROS_SUPER_CLIENT: plain Discovery Server
# clients. Introspection is a super client per command (jazzy.sh's `ros2cli`;
# f1tenth_ctl's probe and monitor set it for themselves).
# `f1tenth_ctl check` compares this file's result with F1T_SHELL_REF
# (sim_isaac.sh's own `shell` subcommand is interactive and a super client, so
# the reference is the same sequence as a snippet).
_f1t_extra="${F1TENTH_EXTRA_SETUP:-$HOME/dev_ws/jc_env.sh}"
if [ -f "$_f1t_extra" ]; then source "$_f1t_extra" || return 1; fi
unset _f1t_extra
ROS_DOMAIN_ID=42
F1TENTH_DISCOVERY_SERVER=127.0.0.1:11811
source "$F1T_SIM_WS/scripts/env/jazzy.sh" || return 1
[ "$ROS_DISTRO" = jazzy ] || return 1
unset ROS_AUTOMATIC_DISCOVERY_RANGE ROS_LOCALHOST_ONLY ROS_STATIC_PEERS
FASTRTPS_DEFAULT_PROFILES_FILE="$F1T_SIM_WS/src/f1tenth_bringup/config/sim/dds/local.xml"
F1T_SHELL_REF='export ROS_DOMAIN_ID=42 F1TENTH_DISCOVERY_SERVER=127.0.0.1:11811; source "$F1T_SIM_WS/scripts/env/jazzy.sh"; unset ROS_AUTOMATIC_DISCOVERY_RANGE ROS_LOCALHOST_ONLY ROS_STATIC_PEERS; export FASTRTPS_DEFAULT_PROFILES_FILE="$F1T_SIM_WS/src/f1tenth_bringup/config/sim/dds/local.xml"'
F1T_DISCOVERY_SERVER_ID=0

# ---- managed processes (see ctl.env for the meaning) -----------------------------
# As sim_isaac.sh's stack_cmd on linus (8 CPUs < the Orin's 12: its host
# overlay config/sim/hosts/linus.yaml), with the car's defaults for the logger
# (off). No llama-server on linus: intelligence off, so a planner started here
# waits 90 s for it and then exits 1 (status: crashed).
F1T_STACK_CMD="ros2 launch f1tenth_bringup supervisor_bringup.launch.py sim:=isaac use_sim_time:=true discovery_server_address:=127.0.0.1 discovery_server_port:=11811 fastdds_profile:=\$FASTRTPS_DEFAULT_PROFILES_FILE sim_overlay_extra:=\$(ros2 pkg prefix f1tenth_bringup)/share/f1tenth_bringup/config/sim/hosts/linus.yaml enable_intelligence:=false enable_mission_logger:=false"
F1T_STACK_NODES="/component_supervisor_node"
F1T_STACK_MATCH="ros2 launch f1tenth_bringup (supervisor_bringup|stack_bringup)\.launch\.py"

F1T_PLANNER_CMD="ros2 run llm llm_planner_node --dry-run"
F1T_PLANNER_NODES="/llm_planner_node"
F1T_PLANNER_MATCH="llm_planner_node"
F1T_PLANNER_STDIN=fifo

F1T_LOGGER_CMD="ros2 launch f1tenth_logger mission_logger.launch.py enable_mission_logger:=true"
F1T_LOGGER_NODES="/mission_logger_node"
F1T_LOGGER_MATCH="ros2 launch f1tenth_logger mission_logger\.launch\.py"

# ---- READY, stop, e-stop ------------------------------------------------------------
F1T_READY_FILE=ready_sim.yaml   # relative to this file, as in ctl.env
F1T_CHECK_PACKAGES="f1tenth_bringup f1tenth_logger llm f1tenth_messages ackermann_msgs slam_toolbox py_trees_ros"
F1T_STOP_SIGINT_WAIT_S=10
F1T_STOP_SIGTERM_WAIT_S=5
F1T_KILLALL_SIGINT_WAIT_S=5
F1T_KILLALL_SIGTERM_WAIT_S=3
F1T_ESTOP_SERVICE=/mission/emergency_stop
F1T_ESTOP_SERVICE_TIMEOUT_S=0.5
F1T_ESTOP_ABORT_TIMEOUT_S=1.0
F1T_ESTOP_TOPIC=/safety_stop
F1T_ESTOP_PUBLISH_S=2.0
F1T_ESTOP_PUBLISH_HZ=50
# Kept apart from the car profile's state, so the two never mix on one host.
F1T_STATE_DIR="$HOME/.local/state/f1tenth_ctl/sim"
