# f1tenth_ctl environment for the Gazebo SIM on linus (ROS 2 Jazzy, one host).
#
# Same contract as ctl.env: bash, sourced with `set -a` on a minimal base
# environment for every process f1tenth_ctl starts. Use it with
#   F1T_CTL_ENV=<this file> f1tenth_ctl ...     or   f1tenth_ctl --env <this file> ...
#
# The car's branch (Humble) has no sim mode in its supervisor, so the sim
# runs a `jazzy` checkout: Gazebo (f1tenth_sim) plus the stack with sim:=true.
# linus lacks some packages that stack needs (slam_toolbox, py_trees_ros,
# topic_tools: no apt access); build them in an underlay and build the jazzy
# workspace with that underlay sourced, so its setup.bash chains it.
# The workspace path can be preset before sourcing this file (a wrapper env
# file that sets it and sources this one); the default is:
: "${F1T_SIM_WS:=$HOME/dev_ws/f1tenth_more_simgz}"     # `jazzy`, colcon-built
#
# The simulator itself is not a managed process: it plays the car's hardware
# and is started separately (output/telegram/test.md), e.g.
#   ros2 launch f1tenth_sim sim_bringup.launch.py world:=test_room_6x6 gui:=false camera:=false
# killall stops it too, like any other ROS 2 process of this user.

set +u

# ---- ROS environment: exactly the sim scripts' own -----------------------------
# The rule for every target (output/telegram/discovery.md): what f1tenth_ctl
# starts gets the same ROS environment as a shell on that target. For the sim
# that "shell" is jazzy's scripts/sim/sim_net.sh, which every sim launcher
# sources, so this file sources it too, with the discovery server on
# loopback instead of the Thor (one host). It gives:
#   ROS_DOMAIN_ID=42, RMW_IMPLEMENTATION=rmw_fastrtps_cpp,
#   ROS_DISCOVERY_SERVER=127.0.0.1:11811, FASTRTPS_DEFAULT_PROFILES_FILE =
#   the stack's fastdds_profile.xml (5 s participant lease),
#   and NO ROS_SUPER_CLIENT: plain discovery-server clients. Introspection
#   is a super client per command (its `ros2cli` helper; f1tenth_ctl's
#   probe and monitor set it for themselves).
# `f1tenth_ctl check` compares this file's result with F1T_SHELL_REF.
F1TENTH_SIM_DISCOVERY_IP=127.0.0.1
F1T_SHELL_REF='export F1TENTH_SIM_DISCOVERY_IP=127.0.0.1; source "$F1T_SIM_WS/scripts/sim/sim_net.sh"'
source "$F1T_SIM_WS/scripts/sim/sim_net.sh" || return 1
[ -n "$ROS_DISTRO" ] || return 1
F1T_DISCOVERY_SERVER_ID=0

# ---- managed processes (see ctl.env for the meaning) -----------------------------
# As jazzy:scripts/sim/sim_stack.sh, on loopback, with the car's defaults for
# the logger (off). No llama-server on linus: intelligence off, so a planner
# started here waits 90 s for it and then exits 1 (status: crashed).
F1T_STACK_CMD="ros2 launch f1tenth_bringup supervisor_bringup.launch.py sim:=true discovery_server_address:=127.0.0.1 enable_intelligence:=false enable_mission_logger:=false health_watchdog:=alert"
F1T_STACK_NODES="/component_supervisor_node"
F1T_STACK_MATCH="ros2 launch f1tenth_bringup (supervisor_bringup|stack_bringup)\.launch\.py"

F1T_PLANNER_CMD="ros2 run llm llm_planner_node --dry-run"
F1T_PLANNER_NODES="/llm_planner_node"
F1T_PLANNER_MATCH="llm_planner_node"
F1T_PLANNER_STDIN=fifo

# No ZED depth in this sim run (camera:=false): do not throttle it.
F1T_LOGGER_CMD="ros2 launch f1tenth_logger mission_logger.launch.py enable_mission_logger:=true mission_logger_record_depth:=false"
F1T_LOGGER_NODES="/mission_logger_node"
F1T_LOGGER_MATCH="ros2 launch f1tenth_logger mission_logger\.launch\.py"

# ---- READY, stop, e-stop ------------------------------------------------------------
F1T_READY_FILE="$(dirname "${BASH_SOURCE[0]}")/ready_sim.yaml"
F1T_CHECK_PACKAGES="f1tenth_bringup f1tenth_sim f1tenth_logger llm f1tenth_messages ackermann_msgs slam_toolbox py_trees_ros"
F1T_STOP_SIGINT_WAIT_S=10
F1T_STOP_SIGTERM_WAIT_S=5
F1T_KILLALL_SIGINT_WAIT_S=5
F1T_KILLALL_SIGTERM_WAIT_S=3
F1T_ESTOP_SERVICE=/mission/emergency_stop
F1T_ESTOP_SERVICE_TIMEOUT_S=0.5
F1T_ESTOP_ABORT_TIMEOUT_S=1.0
F1T_ESTOP_TOPIC=/safety_stop
F1T_ESTOP_PUBLISH_S=2.0
F1T_ESTOP_PUBLISH_HZ=50
# Kept apart from the car profile's state, so the two never mix on one host.
F1T_STATE_DIR="$HOME/.local/state/f1tenth_ctl/sim"
