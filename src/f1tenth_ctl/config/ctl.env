# f1tenth_ctl environment for the CAR (jetson-orin, ROS 2 Humble, native).
#
# Sourced by bash, with `set -a`, for EVERY process f1tenth_ctl starts: the
# stack, planner and logger units, the discovery server, the ROS probe behind
# `status`/`estop`, and `ros2 daemon stop`. It is sourced on a minimal base
# environment (HOME, USER, PATH=/usr/bin:..., XDG_RUNTIME_DIR), never on the
# caller's shell, so the result is the same from ssh, from the bot or from a
# terminal.
#
# The ROS part is a copy of the Orin's ~/.bashrc (read 2026-10-20), so a
# stack started by f1tenth_ctl runs exactly as one started by hand from a
# terminal, and `ros2 ...` in an ssh shell sees the graph the bot sees.
# `f1tenth_ctl check` compares the two (F1T_SHELL_REF below) and warns when
# they differ. Keep them in step; better, have ~/.bashrc source this file
# (output/telegram/discovery.md).

# ---- ROS and the workspace -------------------------------------------------
# setup.bash reads unset variables; relax nounset in case the caller set it.
set +u
source /opt/ros/humble/setup.bash || return 1
source "$HOME/dev_ws/f1tenth_more/install/setup.bash" || return 1

# ---- network: as ~/.bashrc ---------------------------------------------------
# RMW_IMPLEMENTATION and ROS_DOMAIN_ID are unset there too: Humble's default
# rmw_fastrtps_cpp, domain 0.
#
# The stack's own discovery server (stack_params.yaml discovery_server_*).
# f1tenth_ctl starts it from this value (`discovery up`); the stack's launch
# reuses a server already listening there.
ROS_DISCOVERY_SERVER=127.0.0.1:11811
# The ros2 CLI from a shell sees this graph only with this file's environment
# AND without the ros2 daemon, which keeps the environment of whoever started
# it:
#   set -a; . ~/dev_ws/f1tenth_more/src/f1tenth_ctl/config/ctl.env; set +a
#   ros2 node list --no-daemon; ros2 topic list --no-daemon
F1T_DISCOVERY_SERVER_ID=0
# ~/.bashrc exports this for every process started from a shell, the stack
# included, so it is here too. Its own comment, and foxglove_bridge.launch.py,
# say the stack's nodes should NOT be super clients: only introspection
# should. That is the proposed setup (output/telegram/discovery.md); it needs
# ~/.bashrc changed with it and a run on the car, so not yet.
# (f1tenth_ctl's probe and monitor are super clients either way.)
ROS_SUPER_CLIENT=TRUE
# CUDA libraries from pip (torch needs libcudss). After the setup.bash lines:
# they overwrite LD_LIBRARY_PATH.
LD_LIBRARY_PATH="$HOME/.local/lib/python3.10/site-packages/nvidia/cu12/lib${LD_LIBRARY_PATH:+:$LD_LIBRARY_PATH}"
# What `check` compares with: `bash -i`, i.e. ~/.bashrc.
F1T_SHELL_REF=interactive

# ---- managed processes ------------------------------------------------------
# F1T_<NAME>_CMD    what the unit runs (bash syntax, after this file is sourced)
# F1T_<NAME>_NODES  node names that mean "<name> is up" (start refuses if one is
#                   already in the graph; status reports them as unmanaged)
# F1T_<NAME>_MATCH  regex over process command lines for the same check
#
# The stack: the supervisor bringup, defaults unchanged (llama-server on,
# mission logger off).
F1T_STACK_CMD="ros2 launch f1tenth_bringup supervisor_bringup.launch.py"
F1T_STACK_NODES="/component_supervisor_node"
F1T_STACK_MATCH="ros2 launch f1tenth_bringup (supervisor_bringup|stack_bringup)\.launch\.py"

# The LLM planner in interactive mode, stdin on a FIFO (it reads one command
# per line; `f1tenth_ctl send planner "..."`), PLAN-ONLY: --dry-run is the
# planner's own flag, so it translates, prints and writes the mission but
# never calls /mission/load_mission or /mission/start_mission. f1tenth_ctl
# stores each planned mission (missions.py) and only `mission-load <id>` +
# `mission-start` run it. Run by hand without --dry-run it behaves as before.
# It needs llama-server, which the stack's 'intelligence' component starts
# (enable_intelligence, default true): without it the planner's warm-up fails
# and the unit shows crashed.
F1T_PLANNER_CMD="ros2 run llm llm_planner_node --dry-run"
F1T_PLANNER_NODES="/llm_planner_node"
F1T_PLANNER_MATCH="llm_planner_node"
F1T_PLANNER_STDIN=fifo

# The mission logger on its own. The stack runs the same launch only with
# enable_mission_logger:=true; then this refuses to start (node already up).
F1T_LOGGER_CMD="ros2 launch f1tenth_logger mission_logger.launch.py enable_mission_logger:=true"
F1T_LOGGER_NODES="/mission_logger_node"
F1T_LOGGER_MATCH="ros2 launch f1tenth_logger mission_logger\.launch\.py"

# ---- READY, stop, e-stop --------------------------------------------------
# Thresholds, relative to this file.
F1T_READY_FILE=ready.yaml
# `check` looks these packages up in AMENT_PREFIX_PATH.
F1T_CHECK_PACKAGES="f1tenth_bringup f1tenth_logger llm f1tenth_messages ackermann_msgs"
# stop: SIGINT to the launch, wait; SIGTERM to the unit, wait; SIGKILL.
F1T_STOP_SIGINT_WAIT_S=10
F1T_STOP_SIGTERM_WAIT_S=5
# killall, for ROS processes outside the units.
F1T_KILLALL_SIGINT_WAIT_S=5
F1T_KILLALL_SIGTERM_WAIT_S=3
# estop, three steps at once: zero drive on the mux's highest-priority lane
# (safety_stop, priority 200, timeout 0.2 s, so >= 20 Hz), the e-stop service
# (latches until 'behavior' restarts) and /mission/abort_mission (ends the
# mission, holds mpc_corr; F1T_MISSION_ABORT_SERVICE, default below).
F1T_ESTOP_SERVICE=/mission/emergency_stop
F1T_ESTOP_SERVICE_TIMEOUT_S=0.5
F1T_ESTOP_ABORT_TIMEOUT_S=1.0
F1T_ESTOP_TOPIC=/safety_stop
F1T_ESTOP_PUBLISH_S=2.0
F1T_ESTOP_PUBLISH_HZ=50
# missions: a stored plan older than this is not loaded or started (plan it
# again); the loader's start countdown (f1tenth_behavior mission_countdown_sec,
# 0 s in stack_params.yaml since 2026-10-21). Only a fallback: mission-start
# reports the countdown the loader's own answer names ("starting in N s").
F1T_MISSION_MAX_AGE_S=300
F1T_MISSION_COUNTDOWN_S=0
# How long a fresh participant gets to receive /mission/status before
# mission-load, mission-start and mission-status give up. Under the discovery
# server above this is not quick: measured on the car 2026-10-21, a new node
# needed between 6 and 10 s for the transient-local sample, and the old 3 s
# budget refused every mission with "no /mission/status: is behavior running?"
# while the BT was publishing it all along. The callers allow 25 s.
F1T_MISSION_DISCOVER_S=15
# Units' logs and state: $HOME/.local/state/f1tenth_ctl
# F1T_STATE_DIR=
