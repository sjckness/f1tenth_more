# f1tenth_ctl environment for the CAR (jetson-orin, ROS 2 Humble, native).
#
# Sourced by bash, with `set -a`, for EVERY process f1tenth_ctl starts: the
# stack, planner and logger units, the discovery server, the ROS probe behind
# `status`/`estop`, and `ros2 daemon stop`. It is sourced on a minimal base
# environment (HOME, USER, PATH=/usr/bin:..., XDG_RUNTIME_DIR), never on the
# caller's shell, so the result is the same from ssh, from the bot or from a
# terminal.
#
# The ROS part is a copy of the Orin's ~/.bashrc (2026-10-20), so a stack
# started by f1tenth_ctl runs exactly as one started by hand in a terminal.
# Keep the two in step. See output/telegram/recon.md section 2.

# ---- ROS and the workspace -------------------------------------------------
# setup.bash reads unset variables; relax nounset in case the caller set it.
set +u
source /opt/ros/humble/setup.bash || return 1
source "$HOME/dev_ws/f1tenth_more/install/setup.bash" || return 1

# ---- network (as ~/.bashrc) -----------------------------------------------
# RMW_IMPLEMENTATION and ROS_DOMAIN_ID are unset on the car: Humble's default
# rmw_fastrtps_cpp and domain 0. Spelled out here so status/check show them.
RMW_IMPLEMENTATION=rmw_fastrtps_cpp
ROS_DOMAIN_ID=0
# The stack's own discovery server (stack_params.yaml discovery_server_*).
# f1tenth_ctl starts it from this value (`discovery up`); the stack's launch
# reuses a server already listening there.
ROS_DISCOVERY_SERVER=127.0.0.1:11811
F1T_DISCOVERY_SERVER_ID=0
# ~/.bashrc makes every process a super client, so the stack gets it here
# too. (f1tenth_ctl's probe sets it for itself either way.) See recon.md for
# the foxglove_bridge.launch.py docstring that says otherwise.
ROS_SUPER_CLIENT=TRUE
# CUDA libraries from pip (onnxruntime / torch). After the setup.bash lines:
# they overwrite LD_LIBRARY_PATH.
LD_LIBRARY_PATH="$HOME/.local/lib/python3.10/site-packages/nvidia/cu12/lib${LD_LIBRARY_PATH:+:$LD_LIBRARY_PATH}"

# ---- managed processes ------------------------------------------------------
# F1T_<NAME>_CMD    what the unit runs (bash syntax, after this file is sourced)
# F1T_<NAME>_NODES  node names that mean "<name> is up" (start refuses if one is
#                   already in the graph; status reports them as unmanaged)
# F1T_<NAME>_MATCH  regex over process command lines for the same check
#
# The stack: the supervisor bringup, defaults unchanged (llama-server on,
# mission logger off).
F1T_STACK_CMD="ros2 launch f1tenth_bringup supervisor_bringup.launch.py"
F1T_STACK_NODES="/component_supervisor_node"
F1T_STACK_MATCH="ros2 launch f1tenth_bringup (supervisor_bringup|stack_bringup)\.launch\.py"

# The LLM planner in interactive mode, stdin on a FIFO (it reads one command
# per line; `f1tenth_ctl send planner "..."`). It needs llama-server, which
# the stack's 'intelligence' component starts (enable_intelligence, default
# true): without it the planner's warm-up fails and the unit shows crashed.
F1T_PLANNER_CMD="ros2 run llm llm_planner_node"
F1T_PLANNER_NODES="/llm_planner_node"
F1T_PLANNER_MATCH="llm_planner_node"
F1T_PLANNER_STDIN=fifo

# The mission logger on its own. The stack runs the same launch only with
# enable_mission_logger:=true; then this refuses to start (node already up).
F1T_LOGGER_CMD="ros2 launch f1tenth_logger mission_logger.launch.py enable_mission_logger:=true"
F1T_LOGGER_NODES="/mission_logger_node"
F1T_LOGGER_MATCH="ros2 launch f1tenth_logger mission_logger\.launch\.py"

# ---- READY, stop, e-stop --------------------------------------------------
# Thresholds, relative to this file.
F1T_READY_FILE=ready.yaml
# `check` looks these packages up in AMENT_PREFIX_PATH.
F1T_CHECK_PACKAGES="f1tenth_bringup f1tenth_logger llm f1tenth_messages ackermann_msgs"
# stop: SIGINT to the launch, wait; SIGTERM to the unit, wait; SIGKILL.
F1T_STOP_SIGINT_WAIT_S=10
F1T_STOP_SIGTERM_WAIT_S=5
# killall, for ROS processes outside the units.
F1T_KILLALL_SIGINT_WAIT_S=5
F1T_KILLALL_SIGTERM_WAIT_S=3
# estop: the e-stop service (latches until 'behavior' restarts) and zero
# drive on the mux's highest-priority lane (safety_stop, priority 200,
# timeout 0.2 s, so >= 20 Hz).
F1T_ESTOP_SERVICE=/mission/emergency_stop
F1T_ESTOP_SERVICE_TIMEOUT_S=0.5
F1T_ESTOP_TOPIC=/safety_stop
F1T_ESTOP_PUBLISH_S=2.0
F1T_ESTOP_PUBLISH_HZ=50
# Units' logs and state: $HOME/.local/state/f1tenth_ctl
# F1T_STATE_DIR=
