# f1tenth_ctl environment for the CAR's Jazzy container on the Orin
# (docker/orin/compose.yaml, service `car`; F1T_CTL_ENV points here).
#
# ctl.env next to this file does the ROS part (scripts/env/jazzy.sh of the
# image's workspace /opt/f1tenth_ws, the discovery server, the managed
# processes); this file then sets what differs in the container:
# - no systemd: the proc backend (one runner process per managed process,
#   f1tenth_ctl/runner.py), always, not by auto-detection;
# - the working directory of the managed processes (relative files such as
#   MPC_corr's mpc_log.csv), on the state mount, not in the image's $HOME;
# - the archive sync: the mission logger writes a trigger file that the host's
#   f1tenth-archive-trigger.path unit watches (no `systemctl --user` here);
# - the provenance of the image (no .git in it): SOURCES and CAR_SYNC.json,
#   read by the mission logger for every run's manifest;
# - the CAR PROFILE: the stack is started with the values the car runs today
#   (output/orin_container/params_delta.md), as explicit launch arguments;
# - optional extra launch arguments for trials (e.g. one Rust switch) from
#   ~/.config/f1tenth_car/stack_args (read-only mount; one line).
#
# Sourced by bash with `set -a`, like ctl.env, by every process f1tenth_ctl
# starts and by the CLI itself: keep it quiet on stdout and never let an
# optional input make it fail (`estop` sources it too).
# shellcheck shell=bash disable=SC2034  # set -a: every assignment is exported

# The workspace this file belongs to (the image: /opt/f1tenth_ws), as ctl.env
# would find it; F1TENTH_WS overrides it.
if [ -z "${F1TENTH_WS:-}" ]; then
  _f1t_ws="$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/../../.." && pwd)"
  [ -f "$_f1t_ws/scripts/env/jazzy.sh" ] || _f1t_ws=/opt/f1tenth_ws
  F1TENTH_WS="$_f1t_ws"
  unset _f1t_ws
fi
. "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/ctl.env" || return 1

# ---- the container ------------------------------------------------------------
F1T_PROCESS_BACKEND=proc
F1T_WORKDIR="$HOME/.local/state/f1tenth_ctl/cwd"
F1TENTH_ARCHIVE_TRIGGER="$HOME/.local/state/f1tenth_archive_trigger/request"
F1TENTH_IMAGE_SOURCES=/opt/f1tenth_ws/SOURCES
F1TENTH_CAR_SYNC=/opt/f1tenth_ws/CAR_SYNC.json

# ---- the car profile ------------------------------------------------------------
# The car (native Humble, stack-campaign-final-2026-10-22 + the car-sync
# commits) runs its stack_params defaults; where the image's defaults differ
# from them, the car's value is passed here explicitly
# (output/orin_container/params_delta.md, tools/car_sync/params_delta.py):
# - enable_intelligence:=true   llama-server with the stack, for the planner
#                               (main defaults it to false since 2026-10-22);
# - enable_mission_logger:=true every mission recorded, by the stack's own
#                               logger, as on the car (the image's default is
#                               true as well; explicit so a default flip on
#                               main does not silently stop the recording);
# - enable_comms:=false         f1tenth_comms needs the host's NetworkManager:
#                               not supported in the container (v1).
F1T_CAR_PROFILE_ARGS="enable_intelligence:=true enable_mission_logger:=true enable_comms:=false"
F1T_STACK_CMD="ros2 launch f1tenth_bringup supervisor_bringup.launch.py $F1T_CAR_PROFILE_ARGS"

# Trials: ONE line of extra launch arguments (name:=value ...), appended after
# the profile (a later name:=value wins in ros2 launch). Anything else in the
# line, or more than one line, and the file is ignored as a whole. The stack's
# log says which (its first line is the full command).
F1T_STACK_ARGS_FILE="$HOME/.config/f1tenth_car/stack_args"
F1T_STACK_ARGS_STATUS=absent
if [ -r "$F1T_STACK_ARGS_FILE" ]; then
  _f1t_lines=$(grep -c '[^[:space:]]' "$F1T_STACK_ARGS_FILE" 2>/dev/null || true)
  _f1t_line=$(grep -m1 '[^[:space:]]' "$F1T_STACK_ARGS_FILE" 2>/dev/null || true)
  _f1t_re='^[A-Za-z_][A-Za-z0-9_]*:=[A-Za-z0-9_./,:+@%-]*$'
  _f1t_ok=1
  [ "${_f1t_lines:-0}" -le 1 ] || _f1t_ok=0
  read -r -a _f1t_toks <<< "$_f1t_line"
  for _f1t_tok in "${_f1t_toks[@]}"; do
    [[ $_f1t_tok =~ $_f1t_re ]] || _f1t_ok=0
  done
  if [ "${#_f1t_toks[@]}" = 0 ]; then
    F1T_STACK_ARGS_STATUS="empty: $F1T_STACK_ARGS_FILE"
  elif [ "$_f1t_ok" = 1 ]; then
    F1T_STACK_CMD="$F1T_STACK_CMD ${_f1t_toks[*]}"
    F1T_STACK_ARGS_STATUS="applied: ${_f1t_toks[*]}"
  else
    F1T_STACK_ARGS_STATUS="IGNORED (one line of name:=value words only): $F1T_STACK_ARGS_FILE"
  fi
  # Logged once, in the stack's own log (stderr of the stack's sourcing).
  if [ "${F1T_UNIT_NAME:-}" = stack ]; then
    echo "[ctl_container.env] stack_args $F1T_STACK_ARGS_STATUS" >&2
  fi
  unset _f1t_lines _f1t_line _f1t_re _f1t_ok _f1t_toks _f1t_tok
fi
