<?xml version="1.0" ?>
<!--
  test_room_6x6: the real test room. 6.0 x 6.0 m INNER size, walls 0.10 m thick
  and 2.5 m high, centred on the origin: inner wall faces at x = +-3.0 and
  y = +-3.0 (wall centres at +-3.05). Plain matte walls and floor.

  Physics, system plugins, scene and sun are the husarion_office_2x.sdf ones
  (4 ms ODE step, real-time factor 1, Contact/Imu/Physics/SceneBroadcaster/
  Sensors/UserCommands), so only the geometry differs from the default world.
  The person and the optional obstacle are NOT in this file: sim_bringup.launch.py
  spawns them (person_*, obstacle_* args), so one world serves every scenario.

  Sensors: the walls are full-height boxes, so they are solid at the LiDAR scan
  plane (z 0.155) and in the whole ZED view (z 0.25, +-50 deg HFOV). Seen from
  the default spawn (x -2.5, facing +x) the far wall is 5.5 m away and spans
  6 m across, so the scan holds a straight wall far longer than the 0.8 m
  segment the wall-stop confirmation (test-campaign, wall_confirm.py) wants.
  NOTE: that confirmation only searches +-30 deg, which spans 2 d tan(30 deg)
  of wall: 0.8 m needs d >= 0.69 m from the LiDAR. A wall stop at 0.5 m
  (LiDAR ~0.42 m from the wall) sees only ~0.49 m -- a limit of the confirm
  parameters, not of this world (see the f1tenth_sim README).
-->
<sdf version="1.9">
  <world name="test_room_6x6">
    <physics name="4ms" type="ode">
      <max_step_size>0.004</max_step_size>
      <real_time_factor>1.0</real_time_factor>
    </physics>
    <plugin filename="gz-sim-contact-system" name="gz::sim::systems::Contact" />
    <plugin filename="gz-sim-imu-system" name="gz::sim::systems::Imu" />
    <plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics" />
    <plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster" />
    <plugin filename="gz-sim-sensors-system" name="gz::sim::systems::Sensors" />
    <plugin filename="gz-sim-user-commands-system" name="gz::sim::systems::UserCommands" />

    <scene>
      <ambient>0.8 0.8 0.8 1</ambient>
      <background>0.6 0.6 0.6 1</background>
      <grid>0</grid>
      <shadows>1</shadows>
    </scene>

    <light name="sun" type="directional">
      <cast_shadows>1</cast_shadows>
      <pose>0 0 10 0 -0 0</pose>
      <diffuse>0.8 0.8 0.8 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <attenuation>
        <range>1000</range>
        <constant>0.9</constant>
        <linear>0.01</linear>
        <quadratic>0.001</quadratic>
      </attenuation>
      <direction>-0.5 0.1 -0.9</direction>
    </light>
    <!-- Ceiling lights: the room is closed on four sides, so the sun alone
         would leave the walls in shadow for the ZED. -->
    <light name="ceiling_a" type="point">
      <cast_shadows>0</cast_shadows>
      <pose>-1.5 0 2.4 0 0 0</pose>
      <diffuse>0.7 0.7 0.7 1</diffuse>
      <specular>0.1 0.1 0.1 1</specular>
      <attenuation><range>12</range><constant>0.5</constant><linear>0.05</linear><quadratic>0.01</quadratic></attenuation>
    </light>
    <light name="ceiling_b" type="point">
      <cast_shadows>0</cast_shadows>
      <pose>1.5 0 2.4 0 0 0</pose>
      <diffuse>0.7 0.7 0.7 1</diffuse>
      <specular>0.1 0.1 0.1 1</specular>
      <attenuation><range>12</range><constant>0.5</constant><linear>0.05</linear><quadratic>0.01</quadratic></attenuation>
    </light>

    <model name="floor">
      <static>true</static>
      <link name="link">
        <collision name="c">
          <geometry><plane><normal>0 0 1</normal><size>20 20</size></plane></geometry>
          <surface><friction><ode><mu>1.0</mu><mu2>1.0</mu2></ode></friction></surface>
        </collision>
        <visual name="v">
          <geometry><plane><normal>0 0 1</normal><size>20 20</size></plane></geometry>
          <material><ambient>0.35 0.35 0.33 1</ambient><diffuse>0.45 0.45 0.42 1</diffuse><specular>0 0 0 1</specular></material>
        </visual>
      </link>
    </model>

    <!-- Four walls, 0.10 m thick, 2.5 m high. The x walls are 6.2 m long so
         the corners close; inner faces at exactly +-3.0. -->
    <model name="wall_px">
      <static>true</static>
      <pose>3.05 0 1.25 0 0 0</pose>
      <link name="link">
        <collision name="c"><geometry><box><size>0.10 6.2 2.5</size></box></geometry></collision>
        <visual name="v"><geometry><box><size>0.10 6.2 2.5</size></box></geometry>
          <material><ambient>0.80 0.79 0.75 1</ambient><diffuse>0.85 0.84 0.80 1</diffuse><specular>0 0 0 1</specular></material></visual>
      </link>
    </model>
    <model name="wall_nx">
      <static>true</static>
      <pose>-3.05 0 1.25 0 0 0</pose>
      <link name="link">
        <collision name="c"><geometry><box><size>0.10 6.2 2.5</size></box></geometry></collision>
        <visual name="v"><geometry><box><size>0.10 6.2 2.5</size></box></geometry>
          <material><ambient>0.80 0.79 0.75 1</ambient><diffuse>0.85 0.84 0.80 1</diffuse><specular>0 0 0 1</specular></material></visual>
      </link>
    </model>
    <model name="wall_py">
      <static>true</static>
      <pose>0 3.05 1.25 0 0 0</pose>
      <link name="link">
        <collision name="c"><geometry><box><size>6.0 0.10 2.5</size></box></geometry></collision>
        <visual name="v"><geometry><box><size>6.0 0.10 2.5</size></box></geometry>
          <material><ambient>0.78 0.80 0.78 1</ambient><diffuse>0.82 0.85 0.82 1</diffuse><specular>0 0 0 1</specular></material></visual>
      </link>
    </model>
    <model name="wall_ny">
      <static>true</static>
      <pose>0 -3.05 1.25 0 0 0</pose>
      <link name="link">
        <collision name="c"><geometry><box><size>6.0 0.10 2.5</size></box></geometry></collision>
        <visual name="v"><geometry><box><size>6.0 0.10 2.5</size></box></geometry>
          <material><ambient>0.78 0.80 0.78 1</ambient><diffuse>0.82 0.85 0.82 1</diffuse><specular>0 0 0 1</specular></material></visual>
      </link>
    </model>
  </world>
</sdf>
