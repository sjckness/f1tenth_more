<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>f1tenth_sim</name>
  <version>0.0.0</version>
  <description>Gazebo Harmonic (ROS 2 Jazzy) simulation for the F1TENTH vehicle.
  Spawns the f1tenth_description model in an empty world and stands in for the
  car's drivers: publishes /scan, /odom, /sensors/imu/raw and /clock (sim
  internals and ground truth under /sim), and drives from /ackermann_drive through ros2_control and an Ackermann
  controller. Publishes nothing on /tf; the stack on the Thor owns TF.</description>
  <maintainer email="andreas21steffens@gmail.com">andreas</maintainer>
  <license>MIT</license>

  <buildtool_depend>ament_python</buildtool_depend>

  <!-- Robot model: URDF, sensors and the gz_ros2_control plugin tags. -->
  <exec_depend>f1tenth_description</exec_depend>

  <!-- Default Gazebo world (office) -->
  <exec_depend>husarion_gz_worlds</exec_depend>

  <!-- Gazebo Harmonic + ROS 2 bridge (Jazzy: ros-jazzy-ros-gz) -->
  <exec_depend>ros_gz_sim</exec_depend>
  <exec_depend>ros_gz_bridge</exec_depend>
  <exec_depend>gz_ros2_control</exec_depend>

  <!-- ros2_control stack -->
  <exec_depend>controller_manager</exec_depend>
  <exec_depend>joint_state_broadcaster</exec_depend>
  <exec_depend>ackermann_steering_controller</exec_depend>

  <!-- private, TF-silent robot_state_publisher for /sim/robot_description -->
  <exec_depend>robot_state_publisher</exec_depend>
  <exec_depend>xacro</exec_depend>
  <!-- optional (foxglove:=true) -->
  <exec_depend>foxglove_bridge</exec_depend>

  <!-- drive bridge node -->
  <exec_depend>rclpy</exec_depend>
  <exec_depend>ackermann_msgs</exec_depend>
  <exec_depend>geometry_msgs</exec_depend>
  <exec_depend>nav_msgs</exec_depend>
  <exec_depend>sensor_msgs</exec_depend>

  <test_depend>ament_copyright</test_depend>
  <test_depend>ament_flake8</test_depend>
  <test_depend>ament_pep257</test_depend>
  <test_depend>python3-pytest</test_depend>
  <test_depend>python3-yaml</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
