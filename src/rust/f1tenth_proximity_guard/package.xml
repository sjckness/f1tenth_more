<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>f1tenth_proximity_guard</name>
  <version>0.1.0</version>
  <description>Front-proximity guard (rclrs): the front check of IsProximityTooClose as its own node, shadow or active</description>
  <maintainer email="andreas21steffens@gmail.com">andreas</maintainer>
  <license>Apache-2.0</license>

  <depend>builtin_interfaces</depend>
  <depend>std_msgs</depend>
  <depend>sensor_msgs</depend>
  <depend>tf2_msgs</depend>
  <depend>geometry_msgs</depend>
  <depend>ackermann_msgs</depend>
  <depend>diagnostic_msgs</depend>
  <!-- ros2-rust/ros2_rust#557: rclrs 0.7 links these through its vendored
       test crates; see output/rust/setup.md (test_msgs underlay). -->
  <depend>example_interfaces</depend>
  <depend>test_msgs</depend>
  <!-- Not used by this crate. cargo resolves EVERY member of the src/rust workspace when it
       builds one, and colcon-ros-cargo patches only the message crates visible to the package
       it builds (its dependencies plus the /opt/ros underlay). f1tenth_costmap_boundary_rs
       needs the WORKSPACE-built f1tenth_messages, so without this line
       `colcon build packages-select f1tenth_proximity_guard` fails to resolve the workspace
       (output/rust/setup.md). Keep every workspace-built message package of any member here. -->
  <build_depend>f1tenth_messages</build_depend>

  <export>
    <build_type>ament_cargo</build_type>
  </export>
</package>
