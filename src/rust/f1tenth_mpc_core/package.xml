<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>f1tenth_mpc_core</name>
  <version>0.1.0</version>
  <description>MPC_corr's corridor geometry in Rust: a ROS-free C-ABI library (libf1tenth_mpc_core.so) that mpc_controller loads with ctypes when corridor_impl is rust</description>
  <maintainer email="andreas21steffens@gmail.com">andreas</maintainer>
  <license>Apache-2.0</license>

  <!-- No ROS dependencies: plain Rust, C ABI in src/ffi.rs. -->
  <!-- Not used by this crate (as in f1tenth_proximity_guard/package.xml): cargo resolves
       EVERY member of the src/rust workspace when it builds one, and colcon-ros-cargo patches
       only the message crates visible to the package it builds. f1tenth_costmap_boundary_rs
       needs the WORKSPACE-built f1tenth_messages, so without this line a clean build
       (no install/ yet) starts this package before f1tenth_messages and fails with
       "no matching package named f1tenth_messages" (found in R4, 2026-10-23). -->
  <build_depend>f1tenth_messages</build_depend>

  <export>
    <build_type>ament_cargo</build_type>
  </export>
</package>
