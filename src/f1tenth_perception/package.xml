<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>f1tenth_perception</name>
  <version>0.0.1</version>
  <description>
    Centralized perception for the F1TENTH car: ZED2 stereo camera (RGB + depth)
    and Hokuyo LiDAR, plus a YOLO 2D detection node. Brings up the sensors and
    publishes vision_msgs/Detection2DArray on /camera/detections.
  </description>
  <maintainer email="andreas21steffens@gmail.com">andreas</maintainer>
  <license>MIT</license>

  <!-- Runtime Python deps for the YOLO detector node -->
  <exec_depend>rclpy</exec_depend>
  <exec_depend>sensor_msgs</exec_depend>
  <exec_depend>vision_msgs</exec_depend>
  <exec_depend>cv_bridge</exec_depend>
  <exec_depend>std_msgs</exec_depend>

  <!-- Runtime Python deps for the 2D-to-3D detection fusion node -->
  <exec_depend>message_filters</exec_depend>
  <exec_depend>visualization_msgs</exec_depend>
  <exec_depend>tf2_ros</exec_depend>
  <exec_depend>tf2_geometry_msgs</exec_depend>
  <exec_depend>geometry_msgs</exec_depend>

  <!-- Runtime Python deps for obstacle_projector_node (3D detections -> 2D
       obstacles for mpc_controller) -->
  <exec_depend>f1tenth_messages</exec_depend>

  <!-- sensor_msgs_py/nav_msgs/python3-scipy and the open3d install note
       previously here were wall_detector_node-only (RANSAC plane
       segmentation for wall/corner detection from the ZED point cloud) -
       removed when that node was retired by the dual-EKF + costmap-
       derived-MPC-boundaries pass in favor of f1tenth_costmap's
       costmap_boundary_node.py. Confirmed via grep that nothing else in
       this package imports any of them before removing. -->

  <!-- Sensors brought up by camera.launch.py / perception.launch.py -->
  <exec_depend>zed_wrapper</exec_depend>
  <exec_depend>urg_node</exec_depend>
  <exec_depend>v4l2_camera</exec_depend>

  <!-- Needed so launch can IncludeLaunchDescription / run nodes -->
  <exec_depend>ros2launch</exec_depend>
  <!-- param_defaults.py: shared launch-param defaults (see f1tenth_params/config/
       stack_params.yaml). f1tenth_params is a dependency-free leaf package;
       depending on it here (not f1tenth_bringup) avoids a build-order cycle,
       since f1tenth_bringup itself includes this package's launch file. -->
  <exec_depend>f1tenth_params</exec_depend>

  <test_depend>ament_copyright</test_depend>
  <test_depend>ament_flake8</test_depend>
  <test_depend>ament_pep257</test_depend>
  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
