<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>f1tenth_perception</name>
  <version>0.0.1</version>
  <description>
    Centralized perception for the F1TENTH car: ZED2 stereo camera (RGB + depth)
    and Hokuyo LiDAR, plus a YOLO 2D detection node. Brings up the sensors and
    publishes vision_msgs/Detection2DArray on /camera/detections.
  </description>
  <maintainer email="andreas21steffens@gmail.com">andreas</maintainer>
  <license>MIT</license>

  <!-- Runtime Python deps for the YOLO detector node -->
  <exec_depend>rclpy</exec_depend>
  <exec_depend>sensor_msgs</exec_depend>
  <exec_depend>vision_msgs</exec_depend>
  <exec_depend>cv_bridge</exec_depend>
  <exec_depend>std_msgs</exec_depend>

  <!-- Runtime Python deps for the 2D-to-3D detection fusion node -->
  <exec_depend>message_filters</exec_depend>
  <exec_depend>visualization_msgs</exec_depend>
  <exec_depend>tf2_ros</exec_depend>
  <exec_depend>tf2_geometry_msgs</exec_depend>
  <exec_depend>geometry_msgs</exec_depend>

  <!-- Runtime Python deps for obstacle_projector_node (3D detections -> 2D
       obstacles for mpc_controller) -->
  <exec_depend>f1tenth_messages</exec_depend>

  <!-- Runtime Python deps for lidar_front_wall_node (forward LiDAR wall-line
       fit): odometry for dead reckoning, and /tf_static read directly into a
       tf2 Buffer. f1tenth_messages above carries WallLineFit/WallEstimate. -->
  <exec_depend>nav_msgs</exec_depend>
  <exec_depend>tf2_msgs</exec_depend>

  <!-- Runtime Python dep for swept_clearance_node: the steering estimate
       reads AckermannDriveStamped off the ackermann_mux output. -->
  <exec_depend>ackermann_msgs</exec_depend>

  <!-- sensor_msgs_py is back since 2026-10-15: front_clearance_node's scene
       mask publishes /perception/wall_points as a PointCloud2 through
       point_cloud2.create_cloud_xyz32. It had been removed with
       wall_detector_node (RANSAC plane segmentation on the ZED point cloud),
       retired by the dual-EKF + costmap-derived-MPC-boundaries pass in favor
       of f1tenth_costmap's costmap_boundary_node.py; nav_msgs and the open3d
       install note went with it and are still gone. -->
  <exec_depend>sensor_msgs_py</exec_depend>

  <!-- Sensors brought up by camera.launch.py / perception.launch.py -->
  <exec_depend>zed_wrapper</exec_depend>
  <exec_depend>urg_node</exec_depend>
  <exec_depend>v4l2_camera</exec_depend>

  <!-- Needed so launch can IncludeLaunchDescription / run nodes -->
  <exec_depend>ros2launch</exec_depend>
  <!-- param_defaults.py: shared launch-param defaults (see f1tenth_params/config/
       stack_params.yaml). f1tenth_params is a dependency-free leaf package;
       depending on it here (not f1tenth_bringup) avoids a build-order cycle,
       since f1tenth_bringup itself includes this package's launch file. -->
  <exec_depend>f1tenth_params</exec_depend>
  <!-- vehicle_frames.base_front_x(): the front bumper offset, read from the
       URDF base_front frame. Every front distance this package publishes is
       measured from it. f1tenth_description depends only on f1tenth_params,
       so this adds no cycle. -->
  <exec_depend>f1tenth_description</exec_depend>
  <!-- multi_wall_tracker.py: line extraction from corridor_perception. -->
  <exec_depend>corridor_perception</exec_depend>
  <exec_depend>python3-scipy</exec_depend>

  <test_depend>ament_copyright</test_depend>
  <test_depend>ament_flake8</test_depend>
  <test_depend>ament_pep257</test_depend>
  <test_depend>python3-pytest</test_depend>
  <!-- NO dependency on f1tenth_wall_tracker_core (src/rust/
       f1tenth_wall_tracker_core, ament_cargo), deliberately, as mpc_controller
       has none on f1tenth_mpc_core: libf1tenth_wall_tracker_core.so is the Rust
       wall tracker wall_tracker_native.py loads with ctypes only when
       wall_tracker_impl is rust (main-jazzy-rust R6), found through ament_index
       in the sourced workspace. A declared dependency would make this package
       unbuildable on a colcon without colcon-ros-cargo (the CLAUDE.md Thor
       trap). Not built: wall_tracker_impl rust refuses the node's start, and the
       rust tests skip. -->

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
