# docker/orin/jazzy_versions.manifest
#
# Target versions for the Orin Jazzy image: what the Thor reference runs.
# Phase 5d D1 builds to these pins and diffs the image's resolved versions
# against this file in output/phase5d_image.md.
#
# STATUS: COMPLETE for ROS, Python and ZED (2026-10-07). Captured read-only
# from andre@jetson-thor at 14:27 CEST; the raw outputs are in thor_capture/:
#   ros_jazzy_dpkg.txt     dpkg-query -W 'ros-jazzy-*'                (386 packages)
#   apt_policy.txt         apt-cache policy ros-jazzy-rclcpp ros-jazzy-ros-base ros-jazzy-fastrtps
#   py_apt.txt             dpkg-query -W 'python3-*' libopencv*
#   pip_freeze.txt         python3 -m pip list --format=freeze        (system + ~/.local)
#   pip_user.txt           python3 -m pip list --user --format=freeze
#   pip_constraints.txt    ~/.config/pip/constraints.txt + pip.conf
#   apt_sources.txt, ros_apt_lists.txt, ros_dpkg_history.txt
#   submodules.txt         git submodule status in ~/dev_ws/f1tenth_more (HEAD 13ba262c)
#   zed_sdk.txt            Camera.hpp version defines, pyzed import, dpkg
#   bashrc_ros_lines.txt   ~/.bashrc lines that touch ROS/ZED
#   platform.txt           OS, kernel, L4T, CUDA, Python, glibc, gcc, cmake
#
# REFRESHED 2026-10-24 for the car image (plan P5, branch main-jazzy-rust):
# [submodules] = the pins of main-jazzy-rust at be849452; new sections
# [snapshots] (Ubuntu + ROS apt snapshots), [rust] (toolchain, RUST=build) and
# [gateway_venv] (the PWA gateway's venv: the pins are gateway-requirements.txt);
# [python] gains the engine-export packages (onnx, onnxslim, onnxruntime), which
# are the Orin Humble host's versions, not the Thor's.
#
# Format: <component> <version> # <source>

[platform]                                  # Thor, for reference only
ubuntu                 24.04.4              # platform.txt
kernel                 6.8.12-tegra         # platform.txt
l4t                    R38.4.0              # /etc/nv_tegra_release, nvidia-l4t-core 38.4.0-20251230160601 (= JetPack 7.1; the nvidia-jetpack meta package is not installed)
cuda                   13.0                 # cuda-toolkit-13-0 13.0.0-1
python                 3.12.3               # platform.txt
glibc                  2.39                 # platform.txt
gcc                    13.3.0               # platform.txt
cmake                  3.28.3               # platform.txt

[ros]                                       # apt, packages.ros.org noble main (live repo, not a snapshot URL)
ros_distro             jazzy
