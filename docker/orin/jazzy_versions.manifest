vesc                   0e74a60090eb084822c7a90e61450fdd5a840a21   # sjckness/vesc, origin/campaign-final = origin/jazzy (vesc_to_odom_backup deadbands, 2026-10-20)
teleop_tools           4337558fd38e0e1a5c08bdd3c7b4b1a9454a74a9   # 1.2.1-15-g4337558, same as Humble
