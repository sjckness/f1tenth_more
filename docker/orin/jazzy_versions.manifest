transport_drivers      apt                                        # removed as a submodule on jazzy; ros-jazzy-serial-driver etc.
# husarion_gz_worlds is no submodule on main-jazzy-rust (sim host only; never staged for the Orin).

[snapshots]                                 # apt archives the image installs from (Dockerfile ARGs)
ubuntu                 20261024T000000Z     # https://snapshot.ubuntu.com/ubuntu/<id>/ (serves arm64; L18). Fallback `none` = live archive
ros                    2026-09-11           # http://snapshots.ros.org/jazzy/<date>/ubuntu, the Thor's set ([ros] apt_sync)

[rust]                                      # RUST=build (Dockerfile rust-build stage); linus's toolchain
rustc                  1.99.1               # rustup-init 1.29.1 (sha256-pinned), --profile minimal
cargo_ament_build      0.1.11               # cargo install --locked
colcon_cargo           0.2.0                # pip
colcon_ros_cargo       0.2.0                # pip
rosidl_generator_rs    0.5.0                # ros-jazzy-rosidl-generator-rs from the ROS snapshot: rclrs 0.8 / rosidl_runtime_rs 0.7 (plan P3.1)
cargo_lock             src/rust/Cargo.lock  # the crates: the build must resolve exactly these (cargo_lock_check.py)

[gateway_venv]                              # /opt/f1tenth_gateway/venv (--system-site-packages), the PWA gateway + faster-whisper
requirements           gateway-requirements.txt   # every package the venv installs, exact pins (diff_manifest.py compares them all)

[environment]                               # Thor ~/.bashrc (bashrc_ros_lines.txt)
bashrc                 "source ~/dev_ws/f1tenth_more/scripts/env/jazzy.sh; export ZED_DIR=/usr/local/zed"   # confirms the FB2 env proposal is live

[workspace]
build_skip             f1tenth_sim f1tenth_more husarion_gz_worlds   # Thor ~/.colcon/defaults.yaml skips the first two; husarion is not initialised there
build_phases           A: all but ament_cargo; B: ament_cargo (RUST=build)   # B reads A's installed message packages (ros-env); offline QDLDL
car_sync               docker/orin/car_sync.json   # shipped as /opt/f1tenth_ws/CAR_SYNC.json; label f1tenth.car_sync.sha256
