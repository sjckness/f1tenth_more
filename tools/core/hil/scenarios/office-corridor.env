# tools/core/hil/scenarios/office-corridor.env - il default del setup B (hil.yaml: world office,
# layout corridor). Serve il mondo office generato: sim_isaac_hil world --convert (una volta).
SCENARIO_DESC="office/corridor: il setup HIL di default, resta su per prove a mano"
SCENARIO_SETUP="setup B, branch hil-isaac: sim/isaac/config/hil.yaml (default), docs/analysis/simulation/2026-11-10_hil-isaac-orin"

SIM_CMD="scripts/sim/sim_isaac_hil sim --world office --layout corridor"
SIM_CONTAINER=f1t_isaac_hil
SIM_TIMEOUT_S=240
SIM_TOPICS="/clock:60 /scan:40 /odom:50 /sensors/imu/raw:50 /camera/image_raw:10 /zed2/zed_node/depth/depth_registered:10"

BRIDGE_CMD=
BRIDGE_TOPICS="/clock:60 /scan:40 /odom:50 /camera/image_raw:10"

STACK_CONTAINER=f1tenth_hil
STACK_IMAGE=
STACK_LAUNCH_ARGS="sim:=isaac use_sim_time:=true"
STACK_TIMEOUT_S=150
STACK_TOPICS="/odometry/filtered:50"

HIL_DOMAIN_ID=44
HIL_RMW=rmw_fastrtps_cpp
HIL_DS_PORT=11812
HIL_SOCKET_BUFFER_MB=16

DRIVE_S=0
AUTO_DOWN=0
