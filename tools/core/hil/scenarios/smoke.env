# tools/core/hil/scenarios/smoke.env - regressione minima prima di un deploy importante:
# avvio, topic vivi, 10 s di guida in rettilineo, poi chiude tutto. f1t deploy --after-hil lo richiede.
SCENARIO_DESC="smoke: avvio sim+stack, topic vivi, 10 s dritto nel corridoio"
SCENARIO_SETUP="setup B, branch hil-isaac: scripts/sim/sim_isaac_hil (mondo corridor), hil_check (topic e frequenze)"

SIM_CMD="scripts/sim/sim_isaac_hil sim --world corridor --layout matte"
SIM_CONTAINER=f1t_isaac_hil
SIM_TIMEOUT_S=180
# hil_check: /clock 60, /scan 40, /odom 50, /sensors/imu/raw 50, camera 10 Hz (hil.yaml)
SIM_TOPICS="/clock:60 /scan:40 /odom:50 /sensors/imu/raw:50 /camera/image_raw:10"

BRIDGE_CMD=
BRIDGE_TOPICS="/clock:60 /scan:40 /odom:50"

STACK_CONTAINER=f1tenth_hil
STACK_IMAGE=
STACK_LAUNCH_ARGS="sim:=isaac use_sim_time:=true"
STACK_TIMEOUT_S=150
STACK_TOPICS="/odometry/filtered:50"

HIL_DOMAIN_ID=44
HIL_RMW=rmw_fastrtps_cpp
HIL_DS_PORT=11812
HIL_SOCKET_BUFFER_MB=16

# lunghezza del corridoio n/d: 0.3 m/s x 10 s = 3 m, OK da 1.5 m
DRIVE_S=10
DRIVE_SPEED=0.3
DRIVE_TOPIC=/ackermann_drive
DRIVE_MIN_DIST_M=1.5
AUTO_DOWN=1
