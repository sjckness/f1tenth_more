# tools/core/hil/scenarios/_template.env - copia in <nome>.env (chiavi: tools/core/schema/scenario.keys).
# Ogni run: f1t hil run <nome> -disp <linus|work>; log in logs/hil/<data>_<disp>_<nome>/.
SCENARIO_DESC="cosa prova, una riga"
SCENARIO_SETUP="branch e script da cui viene (es. hil-isaac: scripts/sim/sim_isaac_hil)"

# ---- sim (host della sim, dentro HOST_HIL_WORKTREE; legge sim/isaac/config/hil.yaml)
SIM_CMD="scripts/sim/sim_isaac_hil sim --world room6x6 --layout default"
SIM_CONTAINER=f1t_isaac_hil
SIM_TIMEOUT_S=180
SIM_TOPICS="/clock:50 /scan:30 /odom:40"

# ---- bridge: il bridge ROS e' dentro Isaac; qui si verifica che l'Orin veda i topic della sim
BRIDGE_CMD=
BRIDGE_TOPICS="/clock:50 /scan:30"

# ---- stack sull'Orin: container separato dall'auto, stessa immagine (quella fissata se vuoto)
STACK_CONTAINER=f1tenth_hil
STACK_IMAGE=
STACK_LAUNCH_ARGS="sim:=isaac use_sim_time:=true"
STACK_TIMEOUT_S=120
STACK_TOPICS="/odometry/filtered:40"

# ---- DDS (devono coincidere con sim/isaac/config/hil.yaml del worktree HIL)
HIL_DOMAIN_ID=44
HIL_RMW=rmw_fastrtps_cpp
HIL_DS_PORT=11812
HIL_SOCKET_BUFFER_MB=16

# ---- guida (0 = niente)
DRIVE_S=0
DRIVE_SPEED=0.3
DRIVE_TOPIC=/ackermann_drive
DRIVE_MIN_DIST_M=1.0
AUTO_DOWN=0
