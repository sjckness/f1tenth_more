# tools/core/config.env - configurazione unica del tooling f1t (bash, CHIAVE=valore).
# Valori per macchina: ~/.config/f1t/config.env (non in git) o variabili F1T_* esportate.
# Chiavi obbligatorie: tools/core/schema/config.keys. Nessuno script contiene questi valori.

# ---- repository
F1T_MAIN_REF=origin/main                 # riferimento per "uguale a main" (doctor, status, precheck)
F1T_CORE_BRANCH=main                     # unico branch su cui si modifica tools/core

# ---- Orin (gestione: ssh via Tailscale, alias in ~/.ssh/config)
F1T_ORIN_HOST=jetson-orin                # alias ssh (HostName 100.96.201.7)
F1T_ORIN_USER=fabiocar
F1T_ORIN_SSH_OPTS="-o BatchMode=yes -o ConnectTimeout=5 -o ServerAliveInterval=15 -o ServerAliveCountMax=4"
F1T_ORIN_CONTAINER=f1tenth_car           # container dell'auto (compose project f1tenth_car)
F1T_ORIN_UNIT=f1tenth-car-container.service   # unit systemd --user che lo avvia
F1T_ORIN_DOCKER_ORIN='~/.local/bin/docker_orin'   # wrapper dell'Orin (pin/up/down/status/history)
F1T_ORIN_STACK_MODE='~/.local/bin/stack_mode'     # native | container
F1T_ORIN_PIN_FILE='~/.config/f1tenth/car_image'   # immagine fissata (scritta da docker_orin pin)
F1T_ORIN_BUILD_REPO='~/dev_ws/f1tenth_car'        # repo dell'Orin da cui si costruisce (solo fetch + worktree temporanei)
F1T_ORIN_NATIVE_WS='~/dev_ws/f1tenth_more'        # checkout nativo (Humble): solo letto, per il drift
F1T_ORIN_BUILD_ROOT=/scratch/fabiocar/f1t_build   # worktree temporanei di build (uno per commit)
F1T_ORIN_XFER=/scratch/fabiocar/xfer              # dove arrivano i bundle git da linus
F1T_ORIN_DEPLOYED_JSON=/etc/f1tenth/deployed.json # cosa gira (scritto da f1t deploy); serve sudo una volta (SUDO_TODO)
F1T_ORIN_DEPLOYED_JSON_FALLBACK='~/.config/f1tenth/deployed.json'  # usato finche' /etc/f1tenth non esiste
F1T_ORIN_OVERRIDE_DIR='~/.config/f1tenth_car'     # unico override a caldo: montato ro nel container (stack_args)

# ---- immagini
F1T_IMAGE_REPO=f1tenth                   # f1tenth:jazzy-orin-<sha7>[-norust]
F1T_IMAGE_PREFIX=jazzy-orin-
F1T_IMAGE_RUST=skip                      # build | skip (skip = suffisso -norust, come l'auto oggi)
F1T_REGISTRY=                            # vuoto: nessun registry, l'immagine nasce sull'Orin (vedi SUDO_TODO)
F1T_BUILD_KEEP_WORKTREES=3               # worktree temporanei di build da tenere sull'Orin
F1T_BUILD_TEST=changed                   # changed | all | none: test pytest nell'immagine dopo la build
F1T_TEST_DOMAIN_ID=147                   # ROS_DOMAIN_ID dei test nell'immagine (rete none)

# ---- deploy
F1T_HEALTH_TIMEOUT_S=60                  # health check post-deploy, poi rollback automatico
F1T_DEPLOY_REQUIRE_TESTED=1              # rifiuta immagini senza label f1tenth.tested=true
F1T_MODULES_EXCLUDE_RE='/(f1tenth_external|vesc|husarion_gz_worlds)/'   # package che non sono moduli nostri

# ---- HIL (comuni; per host: hosts/*.env, per scenario: hil/scenarios/*.env)
F1T_PRECHECK_MAX_AGE_S=600               # run.sh rilancia il precheck se e' piu' vecchio
F1T_CLOCK_WARN_MS=5
F1T_CLOCK_FAIL_MS=50
F1T_PING_COUNT=20
F1T_DISCOVERY_TIMEOUT_S=3
F1T_HIL_LOG_DIR=logs/hil                 # relativo alla radice del repo
