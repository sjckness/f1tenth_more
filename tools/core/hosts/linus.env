# tools/core/hosts/linus.env - linus come host di Isaac Sim nell'HIL con l'Orin.
# Valori dal setup B (branch hil-isaac: sim/isaac/config/hil.yaml, output/hil/setup.md) e da
# docs/analysis/simulation/2026-11-10_hil-isaac-orin/. Chiavi: tools/core/schema/host.keys.
HOST_DESC="linus (x86, RTX 5050 8 GB): Isaac Sim 5.1 in Docker"
HOST_HOSTNAME=linus
HOST_LINK_IFACE=auto                # auto = interfaccia della rotta verso HOST_ORIN_LINK_IP (n/d in hil.yaml)
HOST_LINK_IP=10.42.60.1             # hil.yaml link.workstation_ip
HOST_ORIN_LINK_IP=10.42.60.2        # hil.yaml link.orin_ip
HOST_LINK_MTU=1500
HOST_GPU_NAME="RTX 5050"
HOST_MIN_VRAM_FREE_MB=3500          # isaac_tuning/run_scenario.py: sotto, Isaac va in OUT_OF_DEVICE_MEMORY
HOST_ISAAC_IMAGE=f1tenth_isaac:5.1.0   # hil.yaml sim.image; oggi su linus c'e' solo isaac_ws_devcontainer-isaac-sim:latest (SUDO_TODO/README)
HOST_ISAAC_VERSION=5.1.0
HOST_MIN_DISK_GB=25                 # scripts/sim/sim_isaac.sh
HOST_USER=andreas
HOST_HIL_WORKTREE="$HOME/dev_ws/f1tenth_more_hil"   # branch hil-isaac (scripts/sim/sim_isaac_hil)
HOST_GPU_SERVICES="freeparty-llm.service"           # tiene 5.4 GB di VRAM: va fermato durante Isaac
