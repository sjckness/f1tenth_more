# tools/core/hosts/work.env - la macchina "work" come host di Isaac Sim nell'HIL.
# n/d: nel repo non c'e' nessun dato su questa macchina (hostname, IP, GPU, percorso di Isaac).
# Le chiavi vuote fanno fallire il precheck dicendo quale manca: compilale qui (valori comuni) o in
# ~/.config/f1t/config.env su quella macchina. Chiavi: tools/core/schema/host.keys.
HOST_DESC="work (n/d: da compilare)"
HOST_HOSTNAME=                      # n/d
HOST_LINK_IFACE=auto                # auto = interfaccia della rotta verso HOST_ORIN_LINK_IP
HOST_LINK_IP=10.42.60.1             # stesso piano del setup B (hil.yaml), se il cavo va all'Orin
HOST_ORIN_LINK_IP=10.42.60.2
HOST_LINK_MTU=1500
HOST_GPU_NAME=                      # n/d
HOST_MIN_VRAM_FREE_MB=3500
HOST_ISAAC_IMAGE=f1tenth_isaac:5.1.0
HOST_ISAAC_VERSION=5.1.0
HOST_MIN_DISK_GB=25
HOST_USER=                          # n/d
HOST_HIL_WORKTREE=                  # n/d: checkout del branch hil-isaac su quella macchina
HOST_GPU_SERVICES=
